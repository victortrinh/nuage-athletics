{% comment %}
  Generated by shopify/src/print — do not hand-edit. See shopify/print/README.md.
{% endcomment %}
{%- assign na_lang = order.customer_locale | default: checkout.customer_locale | default: customer.locale | default: 'fr' -%}
{%- assign na_lang2 = na_lang | slice: 0, 2 | downcase -%}
{%- assign en = false -%}
{%- if na_lang2 == 'en' -%}{%- assign en = true -%}{%- endif -%}
<!-- na-locale: {{ na_lang }} -->
<!doctype html>
<html lang="{% if en %}en-CA{% else %}fr-CA{% endif %}">
  <head>
    <meta charset="utf-8" />
    <title>{% if en %}Packing slip{% else %}Bon de livraison{% endif %}</title>
    <style>
      /* The sheet's own margin. A packing slip is read once, next to the
         garment it describes — generous margins cost nothing and keep the
         fold off the type. */
      @page { margin: 14mm; }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
        font-size: 12pt;
        line-height: 1.5;
        color: #0a0a0a;
        /* No background declaration: the ground is the sheet. */
      }

      /* Points, not pixels, throughout: this document has exactly one
         medium and it is measured in physical units. */
      .na-wordmark { display: block; width: 160px; height: auto; border: 0; }
      .na-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16pt; margin: 0 0 24pt; }
      .na-title { font-family: Futura, 'Century Gothic', 'Avenir Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 13pt; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; margin: 0 0 4pt; }
      .na-meta { text-align: right; font-size: 10pt; line-height: 1.6; color: #63696e; white-space: nowrap; }
      .na-meta strong { color: #0a0a0a; font-weight: 600; }

      .na-cols { display: flex; gap: 24pt; margin: 0 0 24pt; }
      .na-col { flex: 1; font-size: 10pt; line-height: 1.6; }
      .na-label { font-size: 9pt; letter-spacing: 0.18em; text-transform: uppercase; color: #63696e; margin: 0 0 4pt; }

      table { width: 100%; border-collapse: collapse; margin: 0 0 20pt; }
      th { font-size: 9pt; letter-spacing: 0.18em; text-transform: uppercase; color: #63696e; font-weight: 600; text-align: left; padding: 0 0 6pt; border-bottom: 1px solid #0a0a0a; }
      th.na-qty, td.na-qty { text-align: right; white-space: nowrap; width: 1%; padding-left: 12pt; }
      td { font-size: 11pt; padding: 8pt 0; border-bottom: 1px solid #dcdcdc; vertical-align: top; }
      /* A line item split across two sheets is the one layout failure that
         actually matters when someone is picking an order from a printout. */
      tr { page-break-inside: avoid; }
      .na-variant { display: block; font-size: 9.5pt; color: #63696e; }
      .na-sku { display: block; font-size: 9pt; color: #63696e; letter-spacing: 0.04em; }

      .na-note { border: 1px solid #dcdcdc; padding: 10pt 12pt; margin: 0 0 20pt; font-size: 10pt; }
      .na-msg { font-size: 10.5pt; line-height: 1.6; margin: 0 0 6pt; }
      .na-foot { margin: 28pt 0 0; padding: 10pt 0 0; border-top: 1px solid #dcdcdc; font-size: 9pt; line-height: 1.6; color: #63696e; }
    </style>
  </head>
  <body>
    <div class="na-head">
      <div>
        <img src="https://nuageathletics.com/img/wordmark-print.png" width="160" height="39" alt="Nuage Athletics" class="na-wordmark" />
      </div>
      <div class="na-meta">
        <div class="na-title">{% if en %}Packing slip{% else %}Bon de livraison{% endif %}</div>
        <div><strong>{{ order.name }}</strong></div>
        <div>{{ order.created_at | date: "%Y-%m-%d" }}</div>
      </div>
    </div>
    <div class="na-cols">
      <div class="na-col">
        <div class="na-label">{% if en %}Ship to{% else %}Expédié à{% endif %}</div>
        {{ order.shipping_address | format_address }}
      </div>
      <div class="na-col">
        <div class="na-label">{% if en %}Order{% else %}Commande{% endif %}</div>
        {{ order.name }}<br />
        {{ order.email }}
      </div>
    </div>
    <table>
      <thead>
        <tr>
          <th>{% if en %}Item{% else %}Article{% endif %}</th>
          <th class="na-qty">{% if en %}Qty{% else %}Qté{% endif %}</th>
        </tr>
      </thead>
      <tbody>
        {% for line_item in line_items %}
        <tr>
          <td>
            {{ line_item.title }}
            {% if line_item.variant_title %}<span class="na-variant">{{ line_item.variant_title }}</span>{% endif %}
            {% if line_item.sku %}<span class="na-sku">{{ line_item.sku }}</span>{% endif %}
          </td>
          <td class="na-qty">{{ line_item.quantity }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if order.note %}
    <div class="na-note">
      <div class="na-label">{% if en %}Note{% else %}Note{% endif %}</div>
      {{ order.note }}
    </div>
    {% endif %}
    <p class="na-msg">{% if en %}Thank you — you are wearing the first garment we ever made.{% else %}Merci — vous portez le premier vêtement que nous ayons fabriqué.{% endif %}</p>
    <p class="na-msg">{% if en %}A problem with your order? Write to us at hello@nuageathletics.com and we will sort it out.{% else %}Un problème avec votre commande&nbsp;? Écrivez-nous à hello@nuageathletics.com et nous le réglerons.{% endif %}</p>
    <p class="na-msg">{% if en %}Our terms of sale: nuageathletics.com/en/pre-contract-information{% else %}Nos conditions de vente&nbsp;: nuageathletics.com/informations-precontractuelles{% endif %}</p>
    <div class="na-foot">
      Nuage Athletics<br />
      {{ shop.address.summary }}<br />
      hello@nuageathletics.com
    </div>
  </body>
</html>
