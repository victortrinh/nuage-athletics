{% comment %}
  Generated by shopify/src — do not hand-edit. See shopify/notifications/README.md.
{% endcomment %}
{%- assign na_lang = order.customer_locale | default: checkout.customer_locale | default: customer.locale | default: 'fr' -%}
{%- assign na_lang2 = na_lang | slice: 0, 2 | downcase -%}
{%- assign en = false -%}
{%- if na_lang2 == 'en' -%}{%- assign en = true -%}{%- endif -%}
<!-- na-locale: {{ na_lang }} -->
<!doctype html>
<html lang="{% if en %}en-CA{% else %}fr-CA{% endif %}" style="color-scheme: light dark;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <title>{% if en %}Order {{ order_name }} cancelled{% else %}Commande {{ order_name }} annulée{% endif %}</title>
    <style>
      [data-ogsc] .email-btn, [data-ogsb] .email-btn {
        background-color: #f2f2f0 !important;
        color: #161616 !important;
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background-color:#0d0d0d;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{% if en %}Your order has been cancelled.{% else %}Votre commande a été annulée.{% endif %}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0d0d0d" background="https://nuageathletics.com/img/email-sky.png" style="background-color:#0d0d0d;background-image:url('https://nuageathletics.com/img/email-sky.png');background-repeat:no-repeat;background-position:center top;background-size:cover;">
      <tr>
        <td align="center" style="padding:48px 16px;">
          <!--[if mso]>
          <table role="presentation" width="520" cellpadding="0" cellspacing="0" border="0"><tr><td>
          <![endif]-->
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#161616" style="max-width:520px;background-color:#161616;border:1px solid #3a3a3a;">
            <tr>
              <td align="center" style="padding:40px 32px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;color:#f2f2f0;text-align:center;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" style="padding:0 0 28px;text-align:center;">
                      <img
                        src="https://nuageathletics.com/img/wordmark-email.png"
                        width="120"
                        height="29"
                        alt="Nuage Athletics"
                        style="display:block;margin:0 auto;border:0;outline:none;width:120px;height:auto;"
                      />
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding:0 0 16px;font-family:Futura, 'Century Gothic', 'Avenir Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:22px;font-weight:600;line-height:1.3;text-align:center;">
                      {% if en %}Order {{ order_name }} cancelled{% else %}Commande {{ order_name }} annulée{% endif %}
                    </td>
                  </tr>
                  <tr>
                    <td align="left" style="text-align:left;">
                      <p style="font-size:15px;line-height:1.6;margin:0 0 16px;color:#f2f2f0;text-align:left;">{% if en %}Your order {{ order_name }} has been cancelled.{% else %}Votre commande {{ order_name }} a été annulée.{% endif %}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;">
  {% for line in line_items %}
  <tr>
    <td style="padding:8px 0;border-bottom:1px solid #3a3a3a;font-size:14px;line-height:1.5;color:#f2f2f0;text-align:left;vertical-align:top;">
      {{ line.title }}{% if line.variant_title %}<br /><span style="font-size:12px;color:#9a9fa4;">{{ line.variant_title }}</span>{% endif %}
    </td>
    <td style="padding:8px 0;border-bottom:1px solid #3a3a3a;font-size:14px;color:#9a9fa4;text-align:center;white-space:nowrap;">× {{ line.quantity }}</td>
    <td style="padding:8px 0;border-bottom:1px solid #3a3a3a;font-size:14px;color:#f2f2f0;text-align:right;white-space:nowrap;">{{ line.final_line_price | money }}</td>
  </tr>
  {% endfor %}
</table>
<p style="font-size:15px;line-height:1.6;margin:0 0 16px;color:#f2f2f0;text-align:left;">{% if en %}If a refund is due, it is processed separately — you will get an email once it has gone through.{% else %}Si un remboursement est dû, il est traité séparément — vous recevrez un courriel une fois le remboursement effectué.{% endif %}</p>
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding:8px 0 0;font-size:13px;color:#9a9fa4;line-height:1.6;text-align:center;">
                      {% if en %}A question about your order? Write to us at <a href="mailto:hello@nuageathletics.com" style="color:#8fa8ff;">hello@nuageathletics.com</a>.{% else %}Une question sur votre commande&nbsp;? Écrivez-nous à <a href="mailto:hello@nuageathletics.com" style="color:#8fa8ff;">hello@nuageathletics.com</a>.{% endif %}
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:32px 0 16px;">
                      <div style="border-top:1px solid #3a3a3a;line-height:0;font-size:0;">&nbsp;</div>
                    </td>
                  </tr>
                  <!-- No CASL sender block: this shell serves Shopify's own
                       customer-notification mail, not the CASL-commercial
                       mail src/lib/email.ts sends (see #91's scope note).
                       The name/address/email footer below is Shopify's own
                       required identification for order mail, not a CASL
                       substitute — SENDER_IDENTITY.name and .email are
                       hardcoded from src/lib/consent.ts; the address is
                       shop.address, resolved by whatever Settings → Store
                       details holds (see #93 and this directory's README). -->
                  <tr>
                    <td align="center" style="font-size:12px;color:#9a9fa4;line-height:1.6;text-align:center;">
                      Nuage Athletics<br />
                      {{ shop.address.summary }}<br />
                      <a href="mailto:hello@nuageathletics.com" style="color:#9a9fa4;">hello@nuageathletics.com</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
