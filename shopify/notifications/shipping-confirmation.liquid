{% comment %}
  Generated by shopify/src — do not hand-edit. See shopify/notifications/README.md.
{% endcomment %}
{%- assign na_lang = order.customer_locale | default: checkout.customer_locale | default: customer.locale | default: 'fr' -%}
{%- assign na_lang2 = na_lang | slice: 0, 2 | downcase -%}
{%- assign en = false -%}
{%- if na_lang2 == 'en' -%}{%- assign en = true -%}{%- endif -%}
<!-- na-locale: {{ na_lang }} -->
<!doctype html>
<html lang="{% if en %}en-CA{% else %}fr-CA{% endif %}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <title>{% if en %}Your order {{ order_name }} is on its way{% else %}Votre commande {{ order_name }} est en route{% endif %}</title>
    <style>
      @media (prefers-color-scheme: dark) {
        .email-outer-bg { background-color: #0d0d0d !important; }
        table.email-outer-bg { background-image: url('https://nuageathletics.com/img/email-sky-dark.png') !important; }
        .email-card { background-color: #161616 !important; border-color: #3a3a3a !important; }
        .email-ink { color: #f2f2f0 !important; }
        .email-mute { color: #9a9fa4 !important; }
        .email-accent { color: #8fa8ff !important; }
        .email-line { border-top-color: #3a3a3a !important; border-bottom-color: #3a3a3a !important; }
        .email-btn { background-color: #f2f2f0 !important; color: #161616 !important; }
        .email-logo-light { display: none !important; }
        .email-logo-dark { display: block !important; }
      }
    </style>
  </head>
  <body class="email-outer-bg" style="margin:0;padding:0;background-color:#e8e8e6;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{% if en %}Your package is on its way.{% else %}Votre colis est en route.{% endif %}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-outer-bg" bgcolor="#e8e8e6" background="https://nuageathletics.com/img/email-sky.png" style="background-color:#e8e8e6;background-image:url('https://nuageathletics.com/img/email-sky.png');background-repeat:no-repeat;background-position:center top;background-size:cover;">
      <tr>
        <td align="center" style="padding:48px 16px;">
          <!--[if mso]>
          <table role="presentation" width="520" cellpadding="0" cellspacing="0" border="0"><tr><td>
          <![endif]-->
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-card" bgcolor="#fafafa" style="max-width:520px;background-color:#fafafa;border:1px solid #dcdcdc;">
            <tr>
              <td align="center" class="email-ink" style="padding:40px 32px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;color:#0a0a0a;text-align:center;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" style="padding:0 0 28px;text-align:center;">
                      <img
                        src="https://nuageathletics.com/img/wordmark-email.png"
                        width="120"
                        height="29"
                        alt="Nuage Athletics"
                        class="email-logo-light"
                        style="display:block;margin:0 auto;border:0;outline:none;width:120px;height:auto;"
                      />
                      <img
                        src="https://nuageathletics.com/img/wordmark-email-dark.png"
                        width="120"
                        height="29"
                        alt="Nuage Athletics"
                        class="email-logo-dark"
                        style="display:none;margin:0 auto;border:0;outline:none;width:120px;height:auto;"
                      />
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding:0 0 16px;font-family:Futura, 'Century Gothic', 'Avenir Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:22px;font-weight:600;line-height:1.3;text-align:center;">
                      {% if en %}Your order {{ order_name }} is on its way{% else %}Votre commande {{ order_name }} est en route{% endif %}
                    </td>
                  </tr>
                  <tr>
                    <td align="left" style="text-align:left;">
                      <p class="email-ink" style="font-size:15px;line-height:1.6;margin:0 0 16px;color:#0a0a0a;text-align:left;">{% if en %}Here's what shipped.{% else %}Voici ce qui a été expédié.{% endif %}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;">
  {% for line in fulfillment.fulfillment_line_items %}
  <tr>
    <td class="email-ink email-line" style="padding:8px 0;border-bottom:1px solid #dcdcdc;font-size:14px;line-height:1.5;color:#0a0a0a;text-align:left;vertical-align:top;">
      {{ line.line_item.title }}{% if line.line_item.variant_title %}<br /><span class="email-mute" style="font-size:12px;color:#63696e;">{{ line.line_item.variant_title }}</span>{% endif %}
    </td>
    <td class="email-mute email-line" style="padding:8px 0;border-bottom:1px solid #dcdcdc;font-size:14px;color:#63696e;text-align:center;white-space:nowrap;">× {{ line.quantity }}</td>
    <td class="email-ink email-line" style="padding:8px 0;border-bottom:1px solid #dcdcdc;font-size:14px;color:#0a0a0a;text-align:right;white-space:nowrap;">{{ line.line_item.final_line_price | money }}</td>
  </tr>
  {% endfor %}
</table>
{% if fulfillment.tracking_number %}
<p class="email-mute" style="font-size:13px;color:#63696e;line-height:1.6;margin:0 0 16px;text-align:left;">{% if en %}Tracking number ({{ fulfillment.tracking_company }}): <a href="{{ fulfillment.tracking_url }}" class="email-accent" style="color:#3a5fd9;">{{ fulfillment.tracking_number }}</a>{% else %}Numéro de suivi ({{ fulfillment.tracking_company }})&nbsp;: <a href="{{ fulfillment.tracking_url }}" class="email-accent" style="color:#3a5fd9;">{{ fulfillment.tracking_number }}</a>{% endif %}</p>
{% endif %}
{% if fulfillment.estimated_delivery_at %}
<p class="email-mute" style="font-size:13px;color:#63696e;line-height:1.6;margin:0 0 16px;text-align:left;">{% if en %}Estimated delivery {{ fulfillment.estimated_delivery_at | date: "%Y-%m-%d" }}.{% else %}Livraison estimée le {{ fulfillment.estimated_delivery_at | date: "%Y-%m-%d" }}.{% endif %}</p>
{% endif %}
<p style="margin:0 0 24px;text-align:left;"><a href="{{ order_status_url }}" class="email-btn" style="display:inline-block;background:#0a0a0a;color:#fafafa;text-decoration:none;padding:12px 22px;font-size:15px;">{% if en %}Track my order{% else %}Suivre ma commande{% endif %}</a></p>
                    </td>
                  </tr>
                  <tr>
                    <td align="center" class="email-mute" style="padding:8px 0 0;font-size:13px;color:#63696e;line-height:1.6;text-align:center;">
                      {% if en %}A question about your order? Write to us at <a href="mailto:hello@nuageathletics.com" class="email-accent" style="color:#3a5fd9;">hello@nuageathletics.com</a>.{% else %}Une question sur votre commande&nbsp;? Écrivez-nous à <a href="mailto:hello@nuageathletics.com" class="email-accent" style="color:#3a5fd9;">hello@nuageathletics.com</a>.{% endif %}
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:32px 0 16px;">
                      <div class="email-line" style="border-top:1px solid #dcdcdc;line-height:0;font-size:0;">&nbsp;</div>
                    </td>
                  </tr>
                  <!-- No CASL sender block: this shell serves Shopify's own
                       customer-notification mail, not the CASL-commercial
                       mail src/lib/email.ts sends (see #91's scope note).
                       The name/address/email footer below is Shopify's own
                       required identification for order mail, not a CASL
                       substitute — SENDER_IDENTITY.name and .email are
                       hardcoded from src/lib/consent.ts; the address is
                       shop.address, resolved by whatever Settings → Store
                       details holds (see #93 and this directory's README). -->
                  <tr>
                    <td align="center" class="email-mute" style="font-size:12px;color:#63696e;line-height:1.6;text-align:center;">
                      Nuage Athletics<br />
                      {{ shop.address.summary }}<br />
                      <a href="mailto:hello@nuageathletics.com" class="email-mute" style="color:#63696e;">hello@nuageathletics.com</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
