{
  "name": "nuage-athletics",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create nuage-athletics",
    "db:migrate:local": "wrangler d1 migrations apply nuage-athletics --local",
    "db:migrate:remote": "wrangler d1 migrations apply nuage-athletics --remote",
    "db:subscribers": "wrangler d1 execute nuage-athletics --remote --command \"SELECT email, locale, status, datetime(consented_at/1000,'unixepoch') AS consented FROM subscribers ORDER BY created_at DESC LIMIT 50\"",
    "broadcast": "node scripts/broadcast.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "marked": "^18.0.9",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.42.0"
  },
  "overrides": {
    "vite": "8.0.16"
  }
}
