# Copy to .dev.vars for local development (gitignored)
#
# Careful: vitest reads this file too (via the Cloudflare pool), so anything
# set here also applies to the test suite.
RESEND_API_KEY=re_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Founder preview. With this set, `/?preview=let-me-in` against `wrangler dev`
# turns on prices and the buy flow for your browser only; `/?preview=` (empty)
# turns them back off. Leave it unset and preview is simply unavailable.
PREVIEW_PASSWORD=let-me-in
