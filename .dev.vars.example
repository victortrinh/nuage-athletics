# Copy to .dev.vars for local development (gitignored)
#
# Careful: vitest reads this file too (via the Cloudflare pool), so anything
# set here also applies to the test suite.
RESEND_API_KEY=re_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Shopify Storefront API. The price and the sold-out state on the product page
# come from here and nowhere else, so without this the buy band never renders —
# founder preview included. The token needs only the default read scopes; the
# store it belongs to is SHOPIFY_STORE_DOMAIN in wrangler.toml's [vars], which
# is where the domain lives now (it is not a credential).
SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Founder preview. With this set, `/?preview=let-me-in` against `wrangler dev`
# turns on prices and the buy flow for your browser only; `/?preview=` (empty)
# turns them back off. Leave it unset and preview is simply unavailable.
PREVIEW_PASSWORD=let-me-in
