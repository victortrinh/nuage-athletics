---
import Base from '../layouts/Base.astro'
import { t } from '../i18n/ui.ts'

const locale = 'fr-CA' as const
const d = t(locale)
---

<Base {locale} routeId="orderCancelled" title={d.orderCancelledTitle} description={d.orderCancelledBody} noindex>
  <section class="max-w-xl py-24">
    <h1 class="text-3xl font-semibold tracking-tight">{d.orderCancelledTitle}</h1>
    <p class="mt-4 opacity-70">{d.orderCancelledBody}</p>
  </section>
</Base>
