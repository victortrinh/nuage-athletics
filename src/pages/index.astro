---
import { env } from 'cloudflare:workers'
import Base from '../layouts/Base.astro'
import ProductView from '../components/ProductView.astro'
import { t } from '../i18n/ui'
import { route } from '../i18n/utils'
import { featuredProduct } from '../lib/catalogue.ts'
import { commerceEnabled, getLiveProduct } from '../lib/commerce/index.ts'

// Founder preview in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets — and a prerendered page would
// also cache one render for everyone. Do not remove.
export const prerender = false

const locale = 'fr-CA' as const
const d = t(locale)
const enHref = route('home', 'en-CA')
// Read per request rather than baked at build: flipping the flag should change
// the page without a rebuild, and a founder carrying the preview cookie gets
// the buy flow while everyone else gets the drop announcement.
const canBuy = await commerceEnabled(env, Astro.request.headers.get('Cookie'))
// Two conditions, one answer. `canBuy` says this visitor is allowed to see a
// price; the Shopify read says there is one to see. Both have to hold, and the
// read is skipped entirely when the first doesn't — nobody browsing the
// pre-drop page should cost a Storefront call.
const storefront = canBuy ? await getLiveProduct(env, featuredProduct(locale).slug, locale) : null
const live = storefront?.product ?? null
// Commerce was on for this request and there is still no price. That renders
// as the ordinary pre-drop page by design (5.5), which leaves nothing on
// screen to tell "not wired up" from "not open yet" — so the reason rides on
// a header instead. It names a category, never a credential, and it changes
// nothing about the page: whoever can see this render sees exactly what
// launch day looks like, header or no header.
if (storefront && !live) {
  Astro.response.headers.set(
    'X-Storefront',
    storefront.detail ? `${storefront.reason};${storefront.detail}` : storefront.reason
  )
}
---

<Base
  {locale}
  routeId="home"
  title={`${d.brand} - ${d.tagline}`}
  description={`${d.tagline} ${d.dropLine}`}
>
  <script slot="head" is:inline define:vars={{ enHref }}>
    // French stays the canonical root for everyone — crawlers, no-JS
    // visitors, and anyone whose language we can't read all get the French
    // page above with no redirect. This nudges an English-primary browser
    // once, and only once (localStorage flag), toward /en/. Client-side and
    // dismissible by design: the raw HTML served here never changes, which
    // keeps French "on terms at least as favourable" as English regardless
    // of what a visitor's browser does with it (Charter of the French
    // Language, see CLAUDE.md).
    ;(function () {
      try {
        var KEY = 'na-locale-nudge'
        if (localStorage.getItem(KEY)) return
        localStorage.setItem(KEY, '1')
        var lang = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase()
        if (lang.indexOf('en') === 0) location.replace(enHref)
      } catch (e) {}
    })()
  </script>

  <ProductView {locale} {live} />
</Base>
