---
// Les divulgations propres aux contrats à distance qu'exige la Loi sur la
// protection du consommateur vivent sur leur propre page — voir
// informations-precontractuelles.astro.
import Base from '../layouts/Base.astro'
import { SENDER_IDENTITY, senderAddressConfigured } from '../lib/consent'
import { env } from 'cloudflare:workers'
import { route } from '../i18n/utils'

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

const locale = 'fr-CA' as const

// null when the SENDER_ADDRESS secret isn't set — the contact block below
// omits the line entirely rather than rendering a placeholder.
const address = senderAddressConfigured(env.SENDER_ADDRESS) ? env.SENDER_ADDRESS : null
---

<Base
  {locale}
  routeId="terms"
  title="Conditions d'utilisation - Nuage Athletics"
  description="Conditions d'utilisation de Nuage Athletics"
>
  <section class="max-w-2xl py-24 space-y-8 text-sm leading-relaxed opacity-90">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight opacity-100">Conditions d'utilisation</h1>
      <p class="mt-4 opacity-70">Dernière mise à jour : 15 septembre 2026</p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Portée</h2>
      <p class="mt-2">
        {SENDER_IDENTITY.name} vend sa première collection directement sur ce site. Les présentes
        conditions régissent l'utilisation du site lui-même; les modalités propres à une commande
        (prix, paiement, livraison, droit de résolution) sont divulguées séparément sur la page{' '}
        <a href={route('precontract', locale)} class="underline">Informations précontractuelles</a>{' '}
        avant que vous ne passiez commande, comme l'exige la Loi sur la protection du consommateur
        du Québec. Rien dans les présentes conditions ne restreint les droits que cette loi vous
        garantit.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Acceptation</h2>
      <p class="mt-2">
        En consultant ou en utilisant ce site, vous acceptez les présentes conditions. Si vous
        n'êtes pas d'accord, veuillez ne pas utiliser le site.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Propriété intellectuelle</h2>
      <p class="mt-2">
        Le contenu de ce site (textes, marque, mise en page) appartient à {SENDER_IDENTITY.name}
        ou est utilisé avec permission. Vous ne pouvez pas le reproduire ou le redistribuer sans
        notre autorisation écrite préalable.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Disponibilité du site</h2>
      <p class="mt-2">
        Nous ne garantissons pas que le site sera exempt d'erreurs ou accessible en tout temps.
        Cette réserve porte sur le fonctionnement du site (pannes, maintenance, contenu) — elle
        n'affecte ni la garantie légale sur les produits vendus, ni les recours que la Loi sur la
        protection du consommateur vous garantit à l'égard d'une commande.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Droit applicable</h2>
      <p class="mt-2">
        Les présentes conditions sont régies par les lois de la province de Québec et les lois
        fédérales du Canada qui s'y appliquent.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Modifications</h2>
      <p class="mt-2">
        Nous pouvons mettre à jour ces conditions à l'occasion. La date de la dernière mise à jour
        figure en haut de cette page.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Contact</h2>
      <p class="mt-2">
        {SENDER_IDENTITY.name}<br />
        {address && <>{address}<br /></>}
        <a href={`mailto:${SENDER_IDENTITY.email}`} class="underline">{SENDER_IDENTITY.email}</a>
      </p>
    </div>
  </section>
</Base>
