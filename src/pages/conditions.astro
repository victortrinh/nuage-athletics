---
import Base from '../layouts/Base.astro'

const locale = 'fr-CA' as const
---

<Base
  {locale}
  routeId="terms"
  title="Conditions d'utilisation — Nuage Athletics"
  description="Conditions d'utilisation"
  noindex
>
  <section class="max-w-2xl py-24 prose-invert">
    <h1 class="text-3xl font-semibold tracking-tight">Conditions d'utilisation</h1>
    <p class="mt-6 opacity-70">
      PLACEHOLDER — à rédiger avant toute vente. Contrats à distance au Québec : la Loi sur la protection du consommateur impose des divulgations précises avant la conclusion du contrat.
    </p>
  </section>
</Base>
