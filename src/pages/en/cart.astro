---
import { env } from 'cloudflare:workers'
import Base from '../../layouts/Base.astro'
import CartView from '../../components/CartView.astro'
import { t } from '../../i18n/ui.ts'
import { commerceEnabled, getLiveProduct, readCart } from '../../lib/commerce/index.ts'
import { featuredProduct } from '../../lib/catalogue.ts'
import { readCartId, cartCookies, cartLineCount } from '../../lib/cart.ts'

/**
 * The cart route — reads the visitor's own cart and hands it to
 * `CartView.astro`, which does the actual rendering (shared with
 * `src/pages/panier.astro`). Kept as its own file, rather than folded
 * entirely into `CartView`, because setting `Cache-Control` and the
 * `X-Storefront` diagnostic is this response's job, not a shared
 * component's.
 */

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

const locale = 'en-CA' as const
const d = t(locale)

// Per-visitor by definition, same reasoning as applyPreview()'s own
// Cache-Control note in src/lib/preview.ts — nothing else in the codebase
// sets this header outside a preview render, and a cart is nobody else's to
// see cached.
Astro.response.headers.set('Cache-Control', 'private, no-store')

const canBuy = await commerceEnabled(env, Astro.request.headers.get('Cookie'))
const cartId = canBuy ? readCartId(Astro.request.headers.get('Cookie')) : undefined
const live = cartId ? await readCart(env, cartId) : null
const cart = live?.cart ?? null

// Availability, from the same read that prices the product page. Without it
// this page renders a line Shopify no longer sells as an ordinary one, next
// to a live-looking checkout button, and the visitor finds out on Shopify's
// hosted page instead (#86). `getLiveProduct` is the seam — never
// `./shopify` (non-negotiable 5) — and it returns null on every Storefront
// failure, which `CartView` renders as "flag nothing" rather than "flag
// everything": see `soldOutSkus` there.
//
// Skipped when there is nothing to check, so an empty cart or a visitor
// without commerce still costs no Storefront call. The reason is not put on
// `X-Storefront` below: that header is the cart read's answer on this
// response, and a second value for a second read would make it ambiguous.
const stock =
  cart && cart.lines.length > 0
    ? await getLiveProduct(env, featuredProduct(locale).slug, locale)
    : null
const stockProduct = stock?.product ?? null

// Same diagnostic header index.astro sets — a real Storefront failure (not
// merely "no cart cookie yet") shouldn't look identical to an empty cart
// from the outside.
if (live && live.reason !== 'ok') {
  Astro.response.headers.set(
    'X-Storefront',
    live.detail ? `${live.reason};${live.detail}` : live.reason
  )
}

// The header count is a cookie, and this page has just read the cart it
// summarizes — so make the two agree rather than leaving the header quoting
// a read that is now older than this one. Costs no extra Storefront call:
// it is `live` above, reused. Skipped when that read failed, since a
// Storefront outage is not evidence that anybody's cart is empty.
if (live && live.reason === 'ok') {
  Astro.locals.cartCount = cartLineCount(cart)
  for (const cookie of cartCookies(cart, Astro.url.protocol === 'https:')) {
    Astro.response.headers.append('Set-Cookie', cookie)
  }
}

const errorCode = Astro.url.searchParams.get('ce') ?? undefined
// The success param carries '1' for an ordinary success, or a notice code
// when Shopify changed what was asked for — see `noticeFor()` in
// src/pages/api/cart.ts. Read here so a no-JS stepper submit renders it
// server-side, which is also what the hydrated swap picks up: that fetch
// follows the same 303 and gets this same render back.
const noticeCode = Astro.url.searchParams.get('added') ?? undefined
---

<Base {locale} routeId="cart" title={d.cartTitle} description={d.cartTitle}>
  <CartView {locale} {cart} live={stockProduct} {errorCode} {noticeCode} />
</Base>
