---
import Base from '../../layouts/Base.astro'

const locale = 'en-CA' as const
---

<Base
  {locale}
  routeId="privacy"
  title="Privacy Policy — Nuage Athletics"
  description="Privacy Policy"
  noindex
>
  <section class="max-w-2xl py-24 prose-invert">
    <h1 class="text-3xl font-semibold tracking-tight">Privacy Policy</h1>
    <p class="mt-6 opacity-70">
      PLACEHOLDER — draft and have reviewed before commercial launch. Must cover: data collected, purpose, retention, CASL (consent and withdrawal), Quebec Law 25, and privacy officer contact details.
    </p>
  </section>
</Base>
