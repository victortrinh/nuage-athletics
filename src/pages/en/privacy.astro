---
import Base from '../../layouts/Base.astro'
import { SENDER_IDENTITY, senderAddressConfigured } from '../../lib/consent'
import { env } from 'cloudflare:workers'

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

const locale = 'en-CA' as const

// null when the SENDER_ADDRESS secret isn't set — the contact block below
// omits the line entirely rather than rendering a placeholder.
const address = senderAddressConfigured(env.SENDER_ADDRESS) ? env.SENDER_ADDRESS : null
---

<Base
  {locale}
  routeId="privacy"
  title="Privacy Policy - Nuage Athletics"
  description="Nuage Athletics privacy policy"
>
  <section class="max-w-2xl py-24 space-y-8 text-sm leading-relaxed opacity-90">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight opacity-100">Privacy Policy</h1>
      <p class="mt-4 opacity-70">Last updated: September 15, 2026</p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Who we are</h2>
      <p class="mt-2">
        {SENDER_IDENTITY.name} sells its first collection of technical apparel, designed in
        Quebec, directly on this site. For any question about this policy, write to us at{' '}
        <a href={`mailto:${SENDER_IDENTITY.email}`} class="underline">{SENDER_IDENTITY.email}</a>.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Information we collect</h2>
      <p class="mt-2">When you sign up for our emails, we collect:</p>
      <ul class="mt-2 list-disc pl-5 space-y-1">
        <li>your email address;</li>
        <li>your IP address;</li>
        <li>technical browser information (user agent);</li>
        <li>the language you signed up in (French or English);</li>
        <li>the page that referred you to the site, if any;</li>
        <li>the timestamp and exact wording of the consent you gave.</li>
      </ul>
      <p class="mt-2">
        When you place an order, payment happens on Shopify's own hosted checkout page, never on
        this site: your name, shipping address, email, and payment details are collected and
        processed by Shopify, acting as our processor. We never see or store your card number.
        The site also sets a technical cookie that identifies your cart to Shopify so it stays
        yours from page to page; it serves no other purpose.
      </p>
      <p class="mt-2">
        The site uses no analytics or advertising tracking of any kind: no Google Analytics, no
        pixels, no profiling. That's why it doesn't show a cookie consent banner — there is
        nothing optional to consent to.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Why we collect it</h2>
      <ul class="mt-2 list-disc pl-5 space-y-1">
        <li>To send you the emails you consented to (release announcements, brand news);</li>
        <li>To prevent abuse and automated signups (rate limiting);</li>
        <li>
          To keep proof of the express consent required by Canada's Anti-Spam Legislation (CASL).
          The burden of proving consent falls on us, not you.
        </li>
        <li>To process, ship, and track your order.</li>
      </ul>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Your consent</h2>
      <p class="mt-2">
        We never infer your consent: the checkbox at signup is never pre-checked. You can
        withdraw your consent at any time by clicking the unsubscribe link in any email we send,
        at no cost and without needing to give a reason.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Who we share it with</h2>
      <p class="mt-2">We use the following processors to run the site:</p>
      <ul class="mt-2 list-disc pl-5 space-y-1">
        <li>Cloudflare (hosting, infrastructure, database);</li>
        <li>Resend (sending transactional and marketing emails);</li>
        <li>Shopify (payment, cart, shipping, and order customer service).</li>
      </ul>
      <p class="mt-2">We do not sell or rent your personal information to third parties for marketing purposes.</p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Retention</h2>
      <p class="mt-2">
        We keep your subscriber record, including your IP address and the text of your consent,
        for as long as necessary to demonstrate the consent CASL requires, or until you exercise
        the rights described below. Withdrawing consent (unsubscribing) stops emails going out;
        some minimal information may be kept longer to demonstrate that the withdrawal was
        honoured. Order-related information is kept by Shopify under its own terms, including for
        our accounting and tax obligations.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Your rights (Quebec's Law 25)</h2>
      <p class="mt-2">Subject to legal exceptions, you have the right to:</p>
      <ul class="mt-2 list-disc pl-5 space-y-1">
        <li>access the personal information we hold about you;</li>
        <li>have it corrected if it is inaccurate, incomplete, or ambiguous;</li>
        <li>withdraw your consent to its use;</li>
        <li>file a complaint with Quebec's Commission d'accès à l'information.</li>
      </ul>
      <p class="mt-2">To exercise these rights, write to the privacy officer below.</p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Privacy officer</h2>
      <p class="mt-2">
        {SENDER_IDENTITY.name}<br />
        {address && <>{address}<br /></>}
        <a href={`mailto:${SENDER_IDENTITY.email}`} class="underline">{SENDER_IDENTITY.email}</a>
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Changes</h2>
      <p class="mt-2">
        We may update this policy from time to time. The last-updated date at the top of this
        page reflects the most recent change.
      </p>
    </div>
  </section>
</Base>
