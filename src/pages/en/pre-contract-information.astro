---
// Quebec's Consumer Protection Act (Loi sur la protection du consommateur)
// requires specific disclosures before a distance contract is formed. This
// used to be a closed <details> at the bottom of the product page
// (CpaDisclosure.astro); it's now its own page, linked from the footer, the
// nav drawer, and directly under the buy control — see ProductStage.tsx.
import Base from '../../layouts/Base.astro'
import { SENDER_IDENTITY, senderAddressConfigured } from '../../lib/consent'
import { env } from 'cloudflare:workers'
import { route } from '../../i18n/utils'
import { featuredProduct } from '../../lib/catalogue'

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

const locale = 'en-CA' as const
const product = featuredProduct(locale)
// null when the SENDER_ADDRESS secret isn't set — the merchant line
// below omits the address entirely rather than rendering a placeholder.
const address = senderAddressConfigured(env.SENDER_ADDRESS) ? env.SENDER_ADDRESS : null
---

<Base
  {locale}
  routeId="precontract"
  title="Pre-contract information - Nuage Athletics"
  description="Pre-contract information required before entering into a distance contract."
>
  <section class="max-w-2xl py-24 space-y-8 text-sm leading-relaxed opacity-90">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight opacity-100">Pre-contract information</h1>
      <p class="mt-4 opacity-70">Last updated: September 15, 2026</p>
    </div>

    <dl class="space-y-6">
      <div>
        <dt class="font-medium opacity-100">Merchant</dt>
        <dd class="mt-1">
          {SENDER_IDENTITY.name}, {address && <>{address}, </>}{' '}
          <a href={`mailto:${SENDER_IDENTITY.email}`} class="underline">
            {SENDER_IDENTITY.email}
          </a>
          . We don't publish a phone number; write to us by email instead — we answer the same
          questions a call would cover.
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Description</dt>
        <dd class="mt-1">
          <a href={route('home', locale)} class="underline">{product.name}</a> — see the product
          page for the full description and specs.
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Price</dt>
        <dd class="mt-1">
          Shown on the product page. No sales tax is charged: as a small supplier, we aren't
          registered for GST or QST. Shipping cost calculated at checkout (flat national rate,
          free above a threshold).
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Payment terms</dt>
        <dd class="mt-1">Credit or debit card, via Shopify, at time of order.</dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Availability</dt>
        <dd class="mt-1">
          Quantities are limited. Adding an item to your cart does not reserve it: availability is
          checked at payment, and an order is confirmed only once payment is accepted. If an item
          becomes unavailable before then, the quantity is adjusted or the item is removed, and
          nothing is charged for an item that isn't shipped.
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Delivery</dt>
        <dd class="mt-1">Canada only, via Canada Post. Estimated timeframe shown at checkout.</dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Right of withdrawal</dt>
        <dd class="mt-1">
          You may cancel your order before it ships by writing to us. If the goods are not
          delivered within 30 days of the agreed date, you may terminate the contract.
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Returns</dt>
        <dd class="mt-1">
          No returns or exchanges for this first release. A problem with your order? Write to us
          at{' '}
          <a href={`mailto:${SENDER_IDENTITY.email}`} class="underline">{SENDER_IDENTITY.email}</a>.
          The legal warranty still applies.
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Language</dt>
        <dd class="mt-1">This contract may be concluded in English.</dd>
      </div>
    </dl>
  </section>
</Base>
