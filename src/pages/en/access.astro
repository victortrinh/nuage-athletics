---
import Base from '../../layouts/Base.astro'
import GateScreen from '../../components/GateScreen.astro'
import { t } from '../../i18n/ui'

export const prerender = false

Astro.response.status = 401

const locale = 'en-CA' as const
const d = t(locale)
---

<Base {locale} routeId="gate" noindex title={`${d.gateTitle} - ${d.brand}`} description={d.gateLede}>
  <GateScreen {locale} />
</Base>
