---
import { env } from 'cloudflare:workers'
import Base from '../../layouts/Base.astro'
import ProductView from '../../components/ProductView.astro'
import { t } from '../../i18n/ui'
import { commerceEnabled } from '../../lib/commerce/index.ts'

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

const locale = 'en-CA' as const
const d = t(locale)
const canBuy = commerceEnabled(env)
---

<Base
  {locale}
  routeId="home"
  title={`${d.brand} - ${d.tagline}`}
  description={`${d.tagline} ${d.dropLine}`}
>
  <ProductView {locale} commerceEnabled={canBuy} />
</Base>
