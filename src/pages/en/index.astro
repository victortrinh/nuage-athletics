---
import Base from '../../layouts/Base.astro'
import SignupForm from '../../components/SignupForm.tsx'
import { t } from '../../i18n/ui'

const locale = 'en-CA' as const
const d = t(locale)
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
---

<Base
  {locale}
  routeId="home"
  title={`${d.brand} - ${d.tagline}`}
  description={`${d.tagline} ${d.dropLine}`}
>
  <section class="max-w-2xl py-16 sm:py-28">
    <h1 class="text-4xl sm:text-6xl font-semibold tracking-tight">{d.tagline}</h1>
    <p class="mt-6 text-lg opacity-70">{d.dropLine}</p>
    <div class="mt-14">
      <SignupForm client:load {locale} {d} turnstileSiteKey={siteKey} />
    </div>
  </section>
  {/* render=explicit is load-bearing — see the note in src/pages/index.astro. */}
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
</Base>
