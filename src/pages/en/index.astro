---
import { env } from 'cloudflare:workers'
import Base from '../../layouts/Base.astro'
import ProductView from '../../components/ProductView.astro'
import { t } from '../../i18n/ui'
import { commerceEnabled } from '../../lib/commerce/index.ts'

// Founder preview in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets — and a prerendered page would
// also cache one render for everyone. Do not remove.
export const prerender = false

const locale = 'en-CA' as const
const d = t(locale)
const canBuy = await commerceEnabled(env, Astro.request.headers.get('Cookie'))
---

<Base
  {locale}
  routeId="home"
  title={`${d.brand} - ${d.tagline}`}
  description={`${d.tagline} ${d.dropLine}`}
>
  <ProductView {locale} commerceEnabled={canBuy} />
</Base>
