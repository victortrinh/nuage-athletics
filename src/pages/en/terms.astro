---
// DRAFT — pending legal review before commercial launch.
// Scope deliberately limited to a marketing / waitlist site: distance-contract
// disclosures (Quebec's Consumer Protection Act) will be added once online
// sales go live.
import Base from '../../layouts/Base.astro'
import { SENDER_IDENTITY } from '../../lib/consent'

const locale = 'en-CA' as const
---

<Base
  {locale}
  routeId="terms"
  title="Terms of Use — Nuage Athletics"
  description="Nuage Athletics terms of use"
  noindex
>
  <section class="max-w-2xl py-24 prose-invert space-y-8 text-sm leading-relaxed opacity-90">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight opacity-100">Terms of Use</h1>
      <p class="mt-3 text-xs uppercase tracking-wide text-amber-400">
        Draft — pending legal review. May not reflect the final text.
      </p>
      <p class="mt-4 opacity-70">Last updated: August 5, 2026</p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Scope</h2>
      <p class="mt-2">
        This site currently exists to announce the launch of the first collection from{' '}
        {SENDER_IDENTITY.name} and to collect signups for our mailing list. No sales take place on this site
        at this time. Once online sales go live, these terms will be updated to include the
        distance-contract disclosures required by Quebec's Consumer Protection Act.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Acceptance</h2>
      <p class="mt-2">
        By visiting or using this site, you agree to these terms. If you do not agree, please do
        not use the site.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Intellectual property</h2>
      <p class="mt-2">
        The content of this site (text, brand, layout) belongs to {SENDER_IDENTITY.name} or is
        used with permission. You may not reproduce or redistribute it without our prior written
        consent.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">No warranty</h2>
      <p class="mt-2">
        This site is provided "as is," without warranty of any kind, to the extent permitted by
        law. We do not guarantee that the site will be error-free or available at all times.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Limitation of liability</h2>
      <p class="mt-2">
        To the extent permitted by law, {SENDER_IDENTITY.name} will not be liable for any
        indirect, incidental, or consequential damages arising from your use of this site.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Governing law</h2>
      <p class="mt-2">
        These terms are governed by the laws of the province of Quebec and the federal laws of
        Canada applicable therein.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Changes</h2>
      <p class="mt-2">
        We may update these terms from time to time, in particular once online sales go live. The
        last-updated date at the top of this page reflects the most recent change.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Contact</h2>
      <p class="mt-2">
        {SENDER_IDENTITY.name}<br />
        {SENDER_IDENTITY.address}<br />
        <a href={`mailto:${SENDER_IDENTITY.email}`} class="underline">{SENDER_IDENTITY.email}</a>
      </p>
    </div>
  </section>
</Base>
