---
// The distance-contract disclosures Quebec's Consumer Protection Act
// requires live on their own page — see pre-contract-information.astro.
import Base from '../../layouts/Base.astro'
import { SENDER_IDENTITY, senderAddressConfigured } from '../../lib/consent'
import { env } from 'cloudflare:workers'
import { route } from '../../i18n/utils'

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

const locale = 'en-CA' as const

// null when the SENDER_ADDRESS secret isn't set — the contact block below
// omits the line entirely rather than rendering a placeholder.
const address = senderAddressConfigured(env.SENDER_ADDRESS) ? env.SENDER_ADDRESS : null
---

<Base
  {locale}
  routeId="terms"
  title="Terms of Use - Nuage Athletics"
  description="Nuage Athletics terms of use"
>
  <section class="max-w-2xl py-24 space-y-8 text-sm leading-relaxed opacity-90">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight opacity-100">Terms of Use</h1>
      <p class="mt-4 opacity-70">Last updated: September 15, 2026</p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Scope</h2>
      <p class="mt-2">
        {SENDER_IDENTITY.name} sells its first collection directly on this site. These terms
        govern use of the site itself; the terms specific to an order (price, payment, delivery,
        right of withdrawal) are disclosed separately on the{' '}
        <a href={route('precontract', locale)} class="underline">Pre-contract information</a>{' '}
        page before you place an order, as Quebec's Consumer Protection Act requires. Nothing in
        these terms limits the rights that law guarantees you.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Acceptance</h2>
      <p class="mt-2">
        By visiting or using this site, you agree to these terms. If you do not agree, please do
        not use the site.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Intellectual property</h2>
      <p class="mt-2">
        The content of this site (text, brand, layout) belongs to {SENDER_IDENTITY.name} or is
        used with permission. You may not reproduce or redistribute it without our prior written
        consent.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Site availability</h2>
      <p class="mt-2">
        We do not guarantee that the site will be error-free or available at all times. This
        reservation is about how the site itself runs (outages, maintenance, content) — it does
        not affect the legal warranty on the products sold, or the remedies Quebec's Consumer
        Protection Act guarantees you on an order.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Governing law</h2>
      <p class="mt-2">
        These terms are governed by the laws of the province of Quebec and the federal laws of
        Canada applicable therein.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Changes</h2>
      <p class="mt-2">
        We may update these terms from time to time. The last-updated date at the top of this
        page reflects the most recent change.
      </p>
    </div>

    <div>
      <h2 class="text-lg font-semibold opacity-100">Contact</h2>
      <p class="mt-2">
        {SENDER_IDENTITY.name}<br />
        {address && <>{address}<br /></>}
        <a href={`mailto:${SENDER_IDENTITY.email}`} class="underline">{SENDER_IDENTITY.email}</a>
      </p>
    </div>
  </section>
</Base>
