---
import { getCatalogueProduct } from '../../../lib/catalogue.ts'
import { route } from '../../../i18n/utils.ts'

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

/** See the note in src/pages/produit/[slug].astro. */
const locale = 'en-CA' as const
const { slug } = Astro.params

if (!slug || !getCatalogueProduct(slug, locale)) {
  return new Response('Not found', { status: 404 })
}

return Astro.redirect(route('home', locale), 301)
---
