---
// BROUILLON — en attente de révision juridique avant le lancement commercial.
// Quebec's Consumer Protection Act (Loi sur la protection du consommateur)
// requires specific disclosures before a distance contract is formed. This
// used to be a closed <details> at the bottom of the product page
// (CpaDisclosure.astro); it's now its own page, linked from the footer, the
// nav drawer, and directly under the buy control — see ProductStage.tsx.
import Base from '../layouts/Base.astro'
import { SENDER_IDENTITY } from '../lib/consent'
import { route } from '../i18n/utils'
import { featuredProduct } from '../lib/catalogue'

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

const locale = 'fr-CA' as const
const product = featuredProduct(locale)
---

<Base
  {locale}
  routeId="precontract"
  title="Informations précontractuelles - Nuage Athletics"
  description="Informations précontractuelles exigées avant la conclusion d'un contrat à distance."
>
  <section class="max-w-2xl py-24 space-y-8 text-sm leading-relaxed opacity-90">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight opacity-100">Informations précontractuelles</h1>
      <p class="mt-3 text-xs uppercase tracking-wide text-warn">
        Brouillon, en attente de révision juridique. Ne reflète pas nécessairement le texte final.
      </p>
    </div>

    <dl class="space-y-6">
      <div>
        <dt class="font-medium opacity-100">Commerçant</dt>
        <dd class="mt-1">
          {SENDER_IDENTITY.name}, {SENDER_IDENTITY.address},{' '}
          <a href={`mailto:${SENDER_IDENTITY.email}`} class="underline">
            {SENDER_IDENTITY.email}
          </a>
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Description</dt>
        <dd class="mt-1">
          <a href={route('home', locale)} class="underline">{product.name}</a> — voir la fiche
          produit pour la description complète et les caractéristiques.
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Prix</dt>
        <dd class="mt-1">
          Indiqué sur la fiche produit, taxes en sus le cas échéant. Frais de livraison calculés
          au moment du paiement (taux fixe national, gratuit à partir d'un certain montant).
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Modalités de paiement</dt>
        <dd class="mt-1">Carte de crédit ou de débit, par l'entremise de Shopify, au moment de la commande.</dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Disponibilité</dt>
        <dd class="mt-1">
          Les quantités sont limitées. Ajouter un article au panier ne le réserve pas : la
          disponibilité est vérifiée au moment du paiement, et une commande n'est confirmée que
          lorsque le paiement est accepté. Si un article devient indisponible avant ce moment, la
          quantité est ajustée ou l'article est retiré, et aucun montant n'est perçu pour un
          article non expédié.
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Livraison</dt>
        <dd class="mt-1">Au Canada seulement. Délai estimé indiqué au moment du paiement.</dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Droit de résolution</dt>
        <dd class="mt-1">
          Vous pouvez annuler votre commande tant qu'elle n'a pas été expédiée en nous écrivant.
          Si le bien n'est pas livré dans les 30 jours suivant la date convenue, vous pouvez
          résoudre le contrat.
        </dd>
      </div>
      <div>
        <dt class="font-medium opacity-100">Langue</dt>
        <dd class="mt-1">Ce contrat peut être conclu en français.</dd>
      </div>
    </dl>
  </section>
</Base>
