---
import { getCatalogueProduct } from '../../lib/catalogue.ts'
import { route } from '../../i18n/utils.ts'

// The gate in src/middleware.ts never runs for a prerendered page —
// Workers serves those straight from assets. Do not remove.
export const prerender = false

/**
 * The homepage is the product page while there is exactly one SKU, so this
 * route redirects into it rather than serving a second copy — two URLs with
 * the same content would split their own ranking and force a canonical choice
 * on a crawler that has no reason to guess right.
 *
 * The route stays because the slug is real and may already be linked, and
 * because a second product turns this back into a genuine page. Then this
 * redirect comes out and the view renders here instead.
 */
const locale = 'fr-CA' as const
const { slug } = Astro.params

if (!slug || !getCatalogueProduct(slug, locale)) {
  return new Response('Not found', { status: 404 })
}

return Astro.redirect(route('home', locale), 301)
---
