---
import '../styles/global.css'
import Seo from '../components/Seo.astro'
import Sky from '../components/Sky.astro'
import Logo from '../components/Logo.astro'
import LocaleSwitcher from '../components/LocaleSwitcher.astro'
import { HTML_LANG, type Locale } from '../i18n/config'
import { route, type RouteId } from '../i18n/utils'
import { t } from '../i18n/ui'
import { buttonVariants } from '../components/ui/button-variants'

interface Props {
  locale: Locale
  routeId?: RouteId
  alternates?: { locale: Locale; path: string }[]
  /** Explicit href for the locale-switch link, when routeId isn't usable. */
  localeHref?: string
  title: string
  description: string
  noindex?: boolean
}

const { locale, routeId, alternates, localeHref, title, description, noindex } = Astro.props
const d = t(locale)
const year = new Date().getFullYear()
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <Seo {locale} {routeId} {alternates} {title} {description} {noindex} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col font-sans antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2 focus:text-sm"
    >
      {d.skipToContent}
    </a>
    <Sky />
    <header class="border-b border-line px-6 py-4 sm:px-10">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-6">
        <a
          href={route('home', locale)}
          aria-label={d.brand}
          class="text-xl hover:text-accent-ink"
        >
          <Logo variant="wordmark" />
        </a>
        <div class="flex items-center gap-6">
          <button
            type="button"
            id="sky-toggle"
            hidden
            data-pause-label={d.skyPause}
            data-resume-label={d.skyResume}
            class={buttonVariants({ variant: 'quiet' })}
          >
            {d.skyPause}
          </button>
          <LocaleSwitcher {locale} {routeId} href={localeHref} />
        </div>
      </div>
    </header>

    <main id="content" class="mx-auto w-full max-w-6xl flex-1 px-6 sm:px-10">
      <slot />
    </main>

    <footer class="mt-16 border-t border-line px-6 py-10 text-xs text-mute sm:px-10">
      <div class="mx-auto max-w-6xl">
        <nav class="flex flex-wrap gap-x-6 gap-y-2 mb-4">
          <a href={route('privacy', locale)} class="hover:text-accent-ink">{d.privacy}</a>
          <a href={route('terms', locale)} class="hover:text-accent-ink">{d.terms}</a>
          <a href="mailto:hello@nuageathletics.com" class="hover:text-accent-ink">{d.contact}</a>
        </nav>
        <p>© {year} {d.brand}. {d.rights}</p>
      </div>
    </footer>
  </body>
</html>
