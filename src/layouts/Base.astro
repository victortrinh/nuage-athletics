---
import '../styles/global.css'
import Seo from '../components/Seo.astro'
import Sky from '../components/Sky.astro'
import Logo from '../components/Logo.astro'
import LocaleSwitcher from '../components/LocaleSwitcher.astro'
import { NavMenu } from '../components/NavMenu'
import { HTML_LANG, type Locale } from '../i18n/config'
import { route, type RouteId } from '../i18n/utils'
import { t } from '../i18n/ui'
import { buttonVariants } from '../components/ui/button-variants'
import { cn } from '../components/ui/cn'

interface Props {
  locale: Locale
  routeId?: RouteId
  alternates?: { locale: Locale; path: string }[]
  /** Explicit href for the locale-switch link, when routeId isn't usable. */
  localeHref?: string
  title: string
  description: string
  noindex?: boolean
}

const { locale, routeId, alternates, localeHref, title, description, noindex } = Astro.props
const d = t(locale)
const year = new Date().getFullYear()
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <Seo {locale} {routeId} {alternates} {title} {description} {noindex} />
    <slot name="head" />
  </head>
  <body class="min-h-svh flex flex-col font-sans antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2 focus:text-sm"
    >
      {d.skipToContent}
    </a>
    <Sky />
    <header class="sticky top-0 z-40 header-veil px-6 pt-safe pb-4 sm:px-10">
      <div class="mx-auto grid max-w-6xl grid-cols-[1fr_auto_1fr] items-center gap-6">
        <NavMenu
          client:load
          links={[
            { label: d.navHome, href: route('home', locale) },
            { label: d.privacy, href: route('privacy', locale) },
            { label: d.terms, href: route('terms', locale) },
            { label: d.contact, href: 'mailto:hello@nuageathletics.com' },
            {
              label: d.instagram,
              href: 'https://instagram.com/nuageathletics',
              external: true,
            },
          ]}
          openLabel={d.navMenu}
          closeLabel={d.navMenuClose}
          navLabel={d.navLabel}
        />
        {/*
          `group` is what lets the wordmark's dot react to hover/focus on the
          whole link rather than only on the 3px of glyph under the pointer —
          see .logo-dot in Logo.astro.
        */}
        <a
          href={route('home', locale)}
          aria-label={d.brand}
          class="group press justify-self-center text-xl hover:text-accent-ink"
        >
          <Logo variant="wordmark" />
        </a>
        <div class="flex items-center justify-end gap-6">
          {/*
            The icon is 24x16, which is under WCAG 2.2's 24x24 target
            minimum on one axis; the flex box around it pads the target out
            to 32x32 without changing how big the cloud is drawn.

            data-paused (set by Sky.astro's script, which owns the state)
            rather than the wind lines' old `hidden` attribute: `hidden` is
            display:none, and nothing animates in or out of that.
          */}
          <button
            type="button"
            id="sky-toggle"
            hidden
            data-pause-label={d.skyPause}
            data-resume-label={d.skyResume}
            aria-label={d.skyPause}
            class={cn(
              buttonVariants({ variant: 'quiet' }),
              'group flex size-8 items-center justify-center'
            )}
          >
            <svg
              class="h-4 w-6 overflow-visible"
              viewBox="0 0 26 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M11 14.5a3.5 3.5 0 0 1-.4-6.98A4.5 4.5 0 0 1 19.4 6a3.6 3.6 0 0 1 .6 7.15V14.5H11Z"
              ></path>
              {/*
                Wind lines promise what the click does, same as the label:
                shown while paused (click animates), hidden while already
                animating (click freezes it still). They now blow in from
                the left instead of appearing, which is the state change the
                button is about — and under prefers-reduced-motion they
                simply appear, in place, with no travel and no fade.
              */}
              <g
                class="sky-icon-wind opacity-0 group-data-[paused=true]:opacity-100 motion-safe:-translate-x-1 motion-safe:transition-[opacity,translate] motion-safe:duration-300 motion-safe:ease-out motion-safe:group-data-[paused=true]:translate-x-0"
              >
                <line x1="1" y1="6" x2="4" y2="6"></line>
                <line x1="0.5" y1="9.5" x2="5.5" y2="9.5"></line>
              </g>
            </svg>
          </button>
          <LocaleSwitcher {locale} {routeId} href={localeHref} />
        </div>
      </div>
    </header>

    <main id="content" class="mx-auto w-full max-w-6xl flex-1 px-6 sm:px-10">
      <slot />
    </main>

    <footer class="mt-24 px-6 py-10 text-xs text-mute sm:px-10">
      <div class="mx-auto max-w-6xl">
        {/*
          underline-sweep, not `hover:underline`: these three are the only
          links on the site with no underline of their own, and a rule that
          draws itself in from the left is the same hairline the layout is
          already built from. It answers :focus-visible too, so tabbing the
          footer gets the affordance and not only the focus outline.
        */}
        <nav aria-label={d.navFooterLabel} class="flex flex-wrap gap-x-6 gap-y-2 mb-4">
          <a href={route('privacy', locale)} class="underline-sweep hover:text-accent-ink">
            {d.privacy}
          </a>
          <a href={route('terms', locale)} class="underline-sweep hover:text-accent-ink">
            {d.terms}
          </a>
          <a href="mailto:hello@nuageathletics.com" class="underline-sweep hover:text-accent-ink">
            {d.contact}
          </a>
        </nav>
        <p>© {year} {d.brand}. {d.rights}</p>
      </div>
    </footer>
  </body>
</html>
