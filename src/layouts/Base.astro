---
import '../styles/global.css'
import Seo from '../components/Seo.astro'
import Sky from '../components/Sky.astro'
import Logo from '../components/Logo.astro'
import LocaleSwitcher from '../components/LocaleSwitcher.astro'
import NavIcon from '../components/NavIcon.astro'
import { HTML_LANG, type Locale } from '../i18n/config'
import { route, type RouteId } from '../i18n/utils'
import { t } from '../i18n/ui'
import { buttonVariants } from '../components/ui/button-variants'
import { cn } from '../components/ui/cn'

interface Props {
  locale: Locale
  routeId?: RouteId
  alternates?: { locale: Locale; path: string }[]
  /** Explicit href for the locale-switch link, when routeId isn't usable. */
  localeHref?: string
  title: string
  description: string
  noindex?: boolean
}

const { locale, routeId, alternates, localeHref, title, description, noindex } = Astro.props
const d = t(locale)
const year = new Date().getFullYear()

// Resolved here rather than in the drawer's markup so route() and ROUTES
// stay server-side. Product routes are deliberately absent — they're
// reached from the page itself, not from chrome.
const navLinks = [
  { href: route('home', locale), label: d.navHome },
  { href: route('privacy', locale), label: d.privacy },
  { href: route('terms', locale), label: d.terms },
  { href: 'mailto:hello@nuageathletics.com', label: d.contact },
  { href: 'https://instagram.com/nuageathletics', label: d.instagram, external: true },
]
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <Seo {locale} {routeId} {alternates} {title} {description} {noindex} />
    <slot name="head" />
  </head>
  <body class="min-h-svh flex flex-col font-sans antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2 focus:text-sm"
    >
      {d.skipToContent}
    </a>
    <Sky />
    <header class="sticky top-0 z-40 header-veil px-6 pt-safe pb-4 sm:px-10">
      <div class="mx-auto grid max-w-7xl grid-cols-[1fr_auto_1fr] items-center gap-6">
        <div class="flex items-center justify-self-start">
          {/*
            The nav drawer, wired by the inline script below — same pattern
            as #sky-toggle: plain markup plus a small script, no framework.
            <dialog> is what earns this its accessibility for free: showModal()
            makes everything outside it inert and puts it in the top layer
            (above the header's z-40 with no z-index of our own needed),
            Escape fires a cancel event, and close() restores focus to
            whatever was focused before — here, the trigger.

            The dialog itself is sized to the full viewport and is the scrim
            (bg-ink/15); the visible drawer is the child div inside it. That
            split is what makes click-outside-to-close simple: a click whose
            target is the dialog element itself (not a descendant) landed on
            the scrim, not the panel — see the script's click listener.
          */}
          <button
            type="button"
            id="nav-trigger"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-label={d.navMenu}
            class={cn(
              buttonVariants({ variant: 'quiet' }),
              'group flex size-8 items-center justify-center'
            )}
          >
            <NavIcon variant="bars" />
          </button>
          <dialog
            id="nav-drawer"
            aria-label={d.navLabel}
            class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none border-0 bg-ink/15 p-0 [&[open]]:flex"
          >
            <div
              id="nav-drawer-panel"
              class="flex h-full w-[min(20rem,85vw)] flex-col border-r border-line bg-paper forced-colors:border-[CanvasText] pt-safe pr-6 pb-[calc(1rem+env(safe-area-inset-bottom,0px))] pl-[calc(1.5rem+env(safe-area-inset-left,0px))]"
            >
              <button
                type="button"
                id="nav-drawer-close"
                aria-label={d.navMenuClose}
                class={cn(
                  buttonVariants({ variant: 'quiet' }),
                  'flex size-8 items-center justify-center self-start'
                )}
              >
                <NavIcon variant="close" />
              </button>
              <nav aria-label={d.navLabel} class="mt-10 flex flex-col items-start gap-5 text-lg">
                {
                  navLinks.map((link) => (
                    <a
                      href={link.href}
                      {...(link.external ? { rel: 'noopener' } : {})}
                      class="underline-sweep hover:text-accent-ink"
                    >
                      {link.label}
                    </a>
                  ))
                }
              </nav>
            </div>
          </dialog>
        </div>
        {/*
          `group` is what lets the wordmark's dot react to hover/focus on the
          whole link rather than only on the 3px of glyph under the pointer —
          see .logo-dot in Logo.astro.
        */}
        <a
          href={route('home', locale)}
          aria-label={d.brand}
          class="group press justify-self-center text-xl hover:text-accent-ink"
        >
          <Logo variant="wordmark" />
        </a>
        <div class="flex items-center justify-end gap-6">
          {/*
            The icon is 24x16, which is under WCAG 2.2's 24x24 target
            minimum on one axis; the flex box around it pads the target out
            to 32x32 without changing how big the cloud is drawn.

            data-paused (set by Sky.astro's script, which owns the state)
            rather than the wind lines' old `hidden` attribute: `hidden` is
            display:none, and nothing animates in or out of that.
          */}
          <button
            type="button"
            id="sky-toggle"
            hidden
            data-pause-label={d.skyPause}
            data-resume-label={d.skyResume}
            aria-label={d.skyPause}
            class={cn(
              buttonVariants({ variant: 'quiet' }),
              'group flex size-8 items-center justify-center'
            )}
          >
            <svg
              class="h-4 w-6 overflow-visible"
              viewBox="0 0 26 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M11 14.5a3.5 3.5 0 0 1-.4-6.98A4.5 4.5 0 0 1 19.4 6a3.6 3.6 0 0 1 .6 7.15V14.5H11Z"
              ></path>
              {/*
                Wind lines promise what the click does, same as the label:
                shown while paused (click animates), hidden while already
                animating (click freezes it still). They now blow in from
                the left instead of appearing, which is the state change the
                button is about — and under prefers-reduced-motion they
                simply appear, in place, with no travel and no fade.
              */}
              <g
                class="sky-icon-wind opacity-0 group-data-[paused=true]:opacity-100 motion-safe:-translate-x-1 motion-safe:transition-[opacity,translate] motion-safe:duration-300 motion-safe:ease-out motion-safe:group-data-[paused=true]:translate-x-0"
              >
                <line x1="1" y1="6" x2="4" y2="6"></line>
                <line x1="0.5" y1="9.5" x2="5.5" y2="9.5"></line>
              </g>
            </svg>
          </button>
          <LocaleSwitcher {locale} {routeId} href={localeHref} />
        </div>
      </div>
    </header>

    <script>
      // Wires the nav drawer declared above. The open/close animations are
      // CSS @keyframes on #nav-drawer and #nav-drawer-panel (global.css),
      // triggered by a data-state attribute this script sets — keyframes,
      // not transitions, because a transition never starts on an element
      // whose display just flipped from none to flex in the same tick,
      // which is exactly what showModal() does.
      const trigger = document.getElementById('nav-trigger')
      const dialog = document.getElementById('nav-drawer')
      const closeButton = document.getElementById('nav-drawer-close')

      if (
        trigger instanceof HTMLButtonElement &&
        dialog instanceof HTMLDialogElement &&
        closeButton instanceof HTMLButtonElement
      ) {
        function prefersReducedMotion() {
          return matchMedia('(prefers-reduced-motion: reduce)').matches
        }

        function open() {
          dialog.showModal()
          trigger.setAttribute('aria-expanded', 'true')
          dialog.dataset.state = 'entering'
        }

        // Reduced-motion visitors get no animation-name at all (the
        // keyframes are gated motion-safe in global.css), so 'animationend'
        // would never fire and the dialog would never close — close it
        // immediately instead of waiting for an event that isn't coming.
        function requestClose() {
          trigger.setAttribute('aria-expanded', 'false')
          if (prefersReducedMotion()) {
            dialog.close()
            return
          }
          dialog.dataset.state = 'exiting'
        }

        dialog.addEventListener('animationend', (event) => {
          if (event.target !== dialog) return
          if (dialog.dataset.state === 'exiting') dialog.close()
          dialog.dataset.state = ''
        })

        trigger.addEventListener('click', open)
        closeButton.addEventListener('click', requestClose)

        // Escape's default action closes <dialog> instantly, with no exit
        // animation — cancel fires first and is cancelable, so intercept it
        // and drive our own animated close instead.
        dialog.addEventListener('cancel', (event) => {
          event.preventDefault()
          requestClose()
        })

        // The dialog element itself is the scrim (bg-ink/15, full viewport);
        // the visible panel is the child div. A click landing on the dialog
        // and not on a descendant is a click on the scrim.
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) requestClose()
        })

        // Closed with no animation, not requestClose(): every link here is
        // a real navigation (including mailto: and the external one), so
        // the page is already on its way out — nothing would see the exit
        // play.
        for (const link of dialog.querySelectorAll('a')) {
          link.addEventListener('click', () => dialog.close())
        }
      }
    </script>

    <main id="content" class="mx-auto w-full max-w-7xl flex-1 px-6 sm:px-10">
      <slot />
    </main>

    <footer class="mt-24 px-6 py-10 text-xs text-mute sm:px-10">
      <div class="mx-auto max-w-7xl">
        {/*
          underline-sweep, not `hover:underline`: these three are the only
          links on the site with no underline of their own, and a rule that
          draws itself in from the left is the same hairline the layout is
          already built from. It answers :focus-visible too, so tabbing the
          footer gets the affordance and not only the focus outline.
        */}
        <nav aria-label={d.navFooterLabel} class="flex flex-wrap gap-x-6 gap-y-2 mb-4">
          <a href={route('privacy', locale)} class="underline-sweep hover:text-accent-ink">
            {d.privacy}
          </a>
          <a href={route('terms', locale)} class="underline-sweep hover:text-accent-ink">
            {d.terms}
          </a>
          <a href="mailto:hello@nuageathletics.com" class="underline-sweep hover:text-accent-ink">
            {d.contact}
          </a>
        </nav>
        <p>© {year} {d.brand}. {d.rights}</p>
      </div>
    </footer>
  </body>
</html>
