---
import '../styles/global.css'
import Seo from '../components/Seo.astro'
import LocaleSwitcher from '../components/LocaleSwitcher.astro'
import { HTML_LANG, type Locale } from '../i18n/config'
import { route, type RouteId } from '../i18n/utils'
import { t } from '../i18n/ui'

interface Props {
  locale: Locale
  routeId: RouteId
  title: string
  description: string
  noindex?: boolean
}

const { locale, routeId, title, description, noindex } = Astro.props
const d = t(locale)
const year = new Date().getFullYear()
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <Seo {locale} {routeId} {title} {description} {noindex} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col font-sans antialiased">
    <header class="flex items-center justify-between px-6 py-6 sm:px-10">
      <a href={route('home', locale)} class="wordmark text-sm uppercase hover:text-accent">
        {d.brand}
      </a>
      <LocaleSwitcher {locale} {routeId} />
    </header>

    <main class="flex-1 px-6 sm:px-10">
      <slot />
    </main>

    <footer class="px-6 py-10 sm:px-10 text-xs opacity-60">
      <nav class="flex flex-wrap gap-x-6 gap-y-2 mb-4">
        <a href={route('privacy', locale)} class="hover:text-accent">{d.privacy}</a>
        <a href={route('terms', locale)} class="hover:text-accent">{d.terms}</a>
        <a href="mailto:hello@nuageathletics.com" class="hover:text-accent">{d.contact}</a>
      </nav>
      <p>© {year} {d.brand}. {d.rights}</p>
    </footer>
  </body>
</html>
