---
import { HTML_LANG, type Locale } from '../i18n/config'
import { alternates, type RouteId } from '../i18n/utils'

interface Props {
  locale: Locale
  routeId: RouteId
  title: string
  description: string
  noindex?: boolean
}

const { locale, routeId, title, description, noindex = false } = Astro.props
const site = Astro.site?.origin ?? 'https://nuageathletics.com'
const alts = alternates(routeId)
const canonical = new URL(alts.find((a) => a.locale === locale)!.path, site).href

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Nuage Athletics',
  url: site,
  email: 'hello@nuageathletics.com',
  areaServed: { '@type': 'Country', name: 'Canada' },
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  alts.map((a) => (
    <link rel="alternate" hreflang={HTML_LANG[a.locale]} href={new URL(a.path, site).href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={new URL(alts.find((a) => a.locale === 'fr-CA')!.path, site).href} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Nuage Athletics" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale.replace('-', '_')} />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(org)} />
