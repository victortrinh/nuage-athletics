---
import SignupForm from './SignupForm.tsx'
import NavIcon from './NavIcon.astro'
import { cn } from './ui/cn'
import { buttonVariants } from './ui/button-variants'
import type { Locale } from '../i18n/config'
import type { Dict } from '../i18n/ui'

interface Props {
  locale: Locale
  d: Dict
  turnstileSiteKey?: string
  /** Carries `sf=prompt` — see the matching comment in Base.astro. */
  redirectTo: string
  /**
   * True when a no-JS submit from this same prompt just bounced back here
   * with an outcome (Base.astro reads `sf`/`sent`/`se`) — forces the band
   * open on first paint, no timer, the same way GateScreen.astro's
   * <details> forces itself open for the same reason.
   */
  initialOpen: boolean
  initialSuccess?: boolean
  initialErrorCode?: string
}

const { locale, d, turnstileSiteKey, redirectTo, initialOpen, initialSuccess, initialErrorCode } =
  Astro.props
---

{/*
  A labelled region, not a <dialog> — non-blocking, no scrim, no focus trap,
  and it never takes focus when it appears. A role="dialog" that doesn't trap
  focus would promise modal behaviour it doesn't deliver.

  hidden (not display:none via a class) is what the script below flips, the
  same signal Astro's client:visible directive already watches for on
  SignupForm below: an island wrapped in something that starts hidden
  defers its own hydration until that ancestor gets a layout box, exactly
  like GateScreen.astro's <details> — see the note there and in
  SignupForm.tsx's Turnstile mount effect. That's what lets Turnstile mount
  correctly with no extra plumbing: hydration itself never starts until the
  container is genuinely visible.
*/}
<div
  id="signup-prompt"
  hidden={initialOpen ? undefined : true}
  role="region"
  aria-labelledby="signup-prompt-label"
  class="prompt-veil fixed inset-x-0 bottom-0 z-50"
>
  <div class="mx-auto max-w-7xl px-6 pt-6 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] sm:px-10">
    <div class="mx-auto max-w-md">
      <div class="flex items-start justify-between gap-4">
        <p id="signup-prompt-label" class="text-[11px] uppercase tracking-label text-mute">
          {d.promptLabel}
        </p>
        <button
          type="button"
          id="signup-prompt-close"
          aria-label={d.promptClose}
          class={cn(
            buttonVariants({ variant: 'quiet' }),
            'flex size-8 shrink-0 items-center justify-center -mt-2 -mr-2'
          )}
        >
          <NavIcon variant="close" />
        </button>
      </div>
      <div class="mt-4">
        <SignupForm
          client:visible
          {locale}
          {d}
          {turnstileSiteKey}
          source="popup"
          idPrefix="signup-prompt"
          {redirectTo}
          {initialErrorCode}
          {initialSuccess}
        />
      </div>
    </div>
  </div>
</div>

<script>
  // Wires the band declared above: a delayed reveal, a dismiss that persists
  // (src/lib/signup-prompt.ts), Escape while focus is inside it, and the
  // same enter/exit keyframe pattern as the nav drawer in Base.astro (see
  // that script's own comments for why keyframes, not transitions).
  import { getStoredPromptState, shouldShow, dismissPrompt, markSubscribed } from '../lib/signup-prompt'

  const root = document.getElementById('signup-prompt')
  const closeButton = document.getElementById('signup-prompt-close')

  if (root instanceof HTMLElement && closeButton instanceof HTMLButtonElement) {
    function prefersReducedMotion() {
      return matchMedia('(prefers-reduced-motion: reduce)').matches
    }

    function requestIdle(cb: () => void) {
      if ('requestIdleCallback' in window) {
        ;(
          window as unknown as { requestIdleCallback: (cb: () => void) => void }
        ).requestIdleCallback(cb)
      } else {
        setTimeout(cb, 200)
      }
    }

    function show() {
      root.hidden = false
      root.dataset.state = 'entering'
    }

    // Reduced-motion visitors get no animation-name at all (the keyframes
    // are gated motion-safe in global.css), so 'animationend' would never
    // fire and the band would stay on screen forever — close it immediately
    // instead of waiting for an event that isn't coming.
    function requestClose() {
      if (prefersReducedMotion()) {
        root.hidden = true
        root.dataset.state = ''
        return
      }
      root.dataset.state = 'exiting'
    }

    root.addEventListener('animationend', (event) => {
      if (event.target !== root) return
      if (root.dataset.state === 'exiting') root.hidden = true
      root.dataset.state = ''
    })

    closeButton.addEventListener('click', () => {
      dismissPrompt()
      requestClose()
    })

    // Scoped to "focus is inside it", not global — this is a non-blocking
    // region, not a modal, so Escape elsewhere on the page shouldn't reach
    // in and close something the visitor isn't even looking at.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      if (root.hidden) return
      if (!root.contains(document.activeElement)) return
      requestClose()
    })

    // SignupForm.tsx dispatches this on window when its own submission
    // succeeds — see the matching comment there for why a plain event
    // rather than a callback prop. idPrefix scopes it to this prompt's own
    // form, not e.g. the product page's "notify me" form on the same page.
    window.addEventListener('nuage:signup-success', (event) => {
      const detail = (event as CustomEvent<{ idPrefix?: string }>).detail
      if (detail?.idPrefix !== 'signup-prompt') return
      markSubscribed()
    })

    // Already open means Base.astro forced it, because a no-JS submit from
    // this same prompt just bounced back with an outcome — show it
    // regardless of any past dismissal, no timer, no animation (it's
    // already part of the first paint).
    const alreadyOpen = !root.hidden

    if (!alreadyOpen && shouldShow(getStoredPromptState(), Date.now())) {
      // Deferred behind requestIdleCallback so the timer's registration
      // itself never competes with first paint or the sky's own startup
      // (src/components/Sky.astro uses the same guard for the same reason).
      requestIdle(() => setTimeout(show, 6000))
    }
  }
</script>
