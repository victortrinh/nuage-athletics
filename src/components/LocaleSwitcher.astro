---
import { LOCALES, type Locale } from '../i18n/config'
import { route, type RouteId } from '../i18n/utils'
import { t } from '../i18n/ui'

interface Props {
  locale: Locale
  // Either a fixed page id from ROUTES, or (for pages like products whose
  // path isn't fixed per locale) the other locale's path directly.
  routeId?: RouteId
  href?: string
}
const { locale, routeId, href } = Astro.props
const other = LOCALES.find((l) => l !== locale)!
if (!routeId && !href) {
  throw new Error('LocaleSwitcher requires either routeId or href')
}
---

<!--
  Bill 96: the French version must be at least as easy to reach as any other.
  Keep this control visible in the header — not buried in a footer.
-->
<a
  href={href ?? route(routeId!, other)}
  hreflang={other}
  rel="alternate"
  class="text-xs tracking-widest uppercase underline underline-offset-4 opacity-70 hover:opacity-100"
>
  {t(locale).switchTo}
</a>
