---
/**
 * The brand mark, from Victor's own vector artwork (public/logo-nuage.svg).
 *
 * The wordmark is that file's six paths verbatim, cropped to the artwork's
 * real bounds — the source ships a 140x140 square with the lettering floating
 * in a band, which would otherwise render as a wordmark surrounded by empty
 * space.
 *
 * The mark reuses the same paths rather than being a second drawing: the "n"
 * as-is, and the dot translated in behind it at the spacing the wordmark
 * itself uses between "e" and the dot. So the two can never drift apart.
 *
 * Inlined rather than <img src>, because an external image cannot inherit
 * `currentColor` — and the supplied grey (#9AA0A6) is 2.3:1 on paper, fine for
 * a logo and far too weak for anything else. Inheriting means the header gets
 * ink and anything on a dark ground can take paper, from the same file.
 *
 * The dot carries `.logo-dot` in both variants so a `.group` ancestor can
 * float it on hover or keyboard focus (Base.astro's home link) — it is the
 * one part of the mark that reads as an object rather than a letter, so it
 * is the one part that moves. It animates the CSS `translate` property, not
 * `transform`: the mark's dot is positioned by a `transform` presentation
 * attribute, and a CSS `transform` would replace it and fling the dot back
 * to where the wordmark keeps it.
 */
interface Props {
  variant?: 'mark' | 'wordmark'
  class?: string
  title?: string
}

const { variant = 'wordmark', class: className = '', title } = Astro.props

// Measured from the source with getBBox rather than estimated.
const VIEWBOX = {
  wordmark: '0 57.21 139.8 34.34',
  mark: '0 57.21 34.55 25.18',
}
---

