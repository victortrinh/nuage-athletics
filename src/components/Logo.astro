  viewBox={VIEWBOX[variant]}
  class={`inline-block h-[1em] w-auto self-start ${className}`}
  fill="currentColor"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  aria-label={title}
