---
/**
 * The brand mark: a rounded lowercase "nuage" followed by a dot, reduced for
 * the small mark to "n" + dot.
 *
 * The artwork arrived as flat images rather than vectors, so the mark is drawn
 * here from primitives — an arch and a circle, which is what the real one is —
 * and the wordmark uses the display stack. Neither is the genuine file.
 *
 * When the real SVGs land, drop them in public/ and swap the markup below;
 * nothing outside this file needs to change. Keep `currentColor` on every
 * stroke and fill so the mark inherits ink here and can be flipped to paper
 * anywhere it sits on a dark ground.
 */
interface Props {
  variant?: 'mark' | 'wordmark'
  class?: string
  title?: string
}

const { variant = 'wordmark', class: className = '', title } = Astro.props
---

{
  variant === 'mark' ? (
    <svg
      viewBox="0 0 32 32"
      class={`inline-block h-[1em] w-[1em] ${className}`}
      fill="none"
      aria-hidden={title ? undefined : 'true'}
      role={title ? 'img' : undefined}
      aria-label={title}
    >
      <path
        d="M6 26 V15 a7 7 0 0 1 14 0 V26"
        stroke="currentColor"
        stroke-width="5.5"
        stroke-linecap="round"
      />
      <circle cx="27" cy="26" r="2.75" fill="currentColor" />
    </svg>
  ) : (
    <span class={`wordmark inline-flex items-baseline leading-none ${className}`}>
      nuage
      <span
        class="ml-[0.08em] inline-block h-[0.2em] w-[0.2em] rounded-full bg-current"
        aria-hidden="true"
      />
    </span>
  )
}
