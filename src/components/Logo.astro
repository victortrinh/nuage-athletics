---
/**
 * The brand mark.
 *
 * Victor's logo is a rounded lowercase "nuage" followed by a dot, with the
 * mark reducing that to "n" + dot. The supplied artwork arrived as flat
 * images rather than vectors, so what ships here is the type treatment the
 * site already used, holding the slot.
 *
 * When the real SVGs land, drop them in public/ and swap the markup below —
 * nothing outside this file needs to change. Keep `currentColor` on every
 * fill so the mark inherits ink here and can be flipped to paper anywhere it
 * sits on a dark ground.
 */
interface Props {
  variant?: 'mark' | 'wordmark'
  class?: string
}

const { variant = 'wordmark', class: className = '' } = Astro.props
---

<span class={`wordmark inline-flex items-baseline leading-none ${className}`}>
  {variant === 'wordmark' ? 'nuage' : 'n'}<span
    class="ml-[0.06em] inline-block h-[0.19em] w-[0.19em] translate-y-[-0.02em] rounded-full bg-current"
    aria-hidden="true"></span>
</span>
