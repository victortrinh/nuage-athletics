---
import { env } from 'cloudflare:workers'
import ProductCarousel from './ProductCarousel.tsx'
import ProductActions from './ProductActions.tsx'
import CpaDisclosure from './CpaDisclosure.astro'
import { t } from '../i18n/ui'
import { HTML_LANG, type Locale } from '../i18n/config'
import { organizationId } from '../lib/brand'
import { editorialFor, featuredProduct, DEFAULT_FIT } from '../lib/catalogue'

interface Props {
  locale: Locale
  commerceEnabled: boolean
}

const { locale, commerceEnabled } = Astro.props
const d = t(locale)
const product = featuredProduct(locale)
const editorial = editorialFor(product.id, locale)
// PUBLIC_TURNSTILE_SITE_KEY is a [vars] entry in wrangler.toml, i.e. a Worker
// runtime binding — not a Vite build-time value, so it must come from the
// `env` import, not `import.meta.env` (which is never populated here and
// silently produced undefined, disabling the widget on every request).
const siteKey = env.PUBLIC_TURNSTILE_SITE_KEY

// A no-JS "notify me" submit (ProductActions' SignupForm, shown only while
// commerce is off) bounces back here the same way the gate's does — see the
// matching comment in GateScreen.astro and subscribe.ts.
//
// The home route also carries the bottom-anchored signup prompt
// (SignupPrompt.astro via Base.astro), whose own no-JS round trip marks
// itself with 'sf=prompt' before it submits (see the comment in Base.astro).
// 'sent'/'se' are otherwise page-global, so without this check a submit from
// either form would render success on both.
const sf = Astro.url.searchParams.get('sf')
const signupSent = sf !== 'prompt' && Astro.url.searchParams.get('sent') === '1'
const signupErrorCode = sf === 'prompt' ? null : Astro.url.searchParams.get('se')

// Built fresh, not Astro.url.search verbatim — a page reached via the
// prompt's own round trip still carries its 'sf=prompt' marker, which this
// form's redirect target must not inherit: submitting *this* form while
// that marker is present would otherwise redirect back here still tagged
// 'sf=prompt', and the check above would then attribute this form's own
// outcome to the prompt instead of itself.
const redirectUrl = new URL(Astro.url.pathname + Astro.url.search, Astro.url.origin)
redirectUrl.searchParams.delete('sf')
const redirectTo = redirectUrl.pathname + redirectUrl.search

const site = Astro.site?.origin ?? 'https://nuageathletics.com'
const productUrl = new URL(Astro.url.pathname, site).href

/**
 * No price is rendered while commerce is off, and the price is left out of the
 * structured data for the same reason: an advertised price is one a Quebec
 * merchant is expected to honour, and the number in the catalogue is still a
 * placeholder. Availability says PreOrder so the omission reads as deliberate.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  url: productUrl,
  name: product.name,
  description: product.description,
  image: product.images.map((src) => new URL(src, Astro.site).href),
  /**
   * A reference, not a copy. This used to be an inline
   * `{'@type': 'Brand', name}`, which is a second, unrelated entity that
   * happens to share a string with the Organization in Seo.astro — a
   * consumer has no way to tell those are the same company. Pointing at that
   * node's @id says it outright. See organizationId() in src/lib/brand.ts.
   */
  brand: { '@id': organizationId(site) },
  material: editorial.specs[0]?.value,
  /**
   * schema.org's countryOfOrigin means country of manufacture, same as a
   * garment tag — it is not the brand's home country or where it was
   * designed. This garment is made in China; catalogue.ts's spec list says
   * so too, split from the separate "Conception"/"Design" row for Quebec so
   * neither fact is stated in a way that could be misread as the other. A
   * shopping engine or answer engine reading `countryOfOrigin: 'Canada'`
   * here — which an earlier version of this field said — would be reading a
   * false Made-in-Canada claim, not a stylistic choice.
   */
  countryOfOrigin: { '@type': 'Country', name: 'China' },
  inLanguage: HTML_LANG[locale],
  ...(commerceEnabled
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: product.price.currency,
          price: (product.price.amount / 100).toFixed(2),
          availability: 'https://schema.org/InStock',
        },
      }
    : { offers: { '@type': 'Offer', availability: 'https://schema.org/PreOrder' } }),
}
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<article class="grid gap-10 py-8 lg:grid-cols-[1fr_24rem] lg:gap-16 lg:py-12">
  <div>
    <ProductCarousel
      client:load
      {d}
      productId={product.id}
      fits={editorial.fits}
      initialFit={DEFAULT_FIT}
    />
    {/* Images are content, not chrome — the carousel needs JS to page
        through them, but every photo still has to reach a no-JS visitor. */}
    <noscript>
      <div class="mt-3 grid grid-cols-2 gap-3">
        {
          editorial.fits.flatMap((fit) =>
            fit.gallery.map((image) => (
              <img
                src={image.src}
                width={image.width}
                height={image.height}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                class="w-full object-contain"
              />
            ))
          )
        }
      </div>
    </noscript>
  </div>

  <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
    <h1 class="wordmark text-3xl leading-none sm:text-4xl">{product.name}</h1>

    {
      !commerceEnabled && (
        <p class="mt-4 inline-block border border-ink px-2 py-1 text-[10px] uppercase tracking-label">
          {d.productComingSoon}
        </p>
      )
    }

    <p class="mt-6 text-base leading-relaxed text-mute">{product.description}</p>

    <div class="mt-10">
      <ProductActions
        client:load
        {locale}
        {d}
        productId={product.id}
        variants={product.variants}
        fits={editorial.fits.map((f) => ({ id: f.id, label: f.label }))}
        initialFit={DEFAULT_FIT}
        {commerceEnabled}
        turnstileSiteKey={siteKey}
        {redirectTo}
        initialErrorCode={signupErrorCode ?? undefined}
        initialSuccess={signupSent}
      />
    </div>

    <h2 class="mt-14 border-t border-line pt-8 text-[11px] uppercase tracking-label text-mute">
      {d.productDetails}
    </h2>
    <dl class="mt-5">
      {
        editorial.specs.map((spec) => (
          <div class="flex justify-between gap-6 border-b border-line py-3 text-sm">
            <dt class="text-mute">{spec.label}</dt>
            <dd class="text-right">{spec.value}</dd>
          </div>
        ))
      }
    </dl>

    {commerceEnabled && <CpaDisclosure {locale} productName={product.name} />}
  </div>
</article>

{
  siteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    />
  )
}
