---
import ProductStage from './ProductStage.tsx'
import ProductDetails from './ProductDetails.astro'
import { fmt, t } from '../i18n/ui'
import { HTML_LANG, type Locale } from '../i18n/config'
import { organizationId } from '../lib/brand'
import { editorialFor, featuredProduct, formatPrice, DEFAULT_FIT, FIT_IDS, type FitId } from '../lib/catalogue'
import type { Product } from '../lib/commerce/types'
import { route } from '../i18n/utils'

interface Props {
  locale: Locale
  /**
   * The product as Shopify currently sells it — copy plus a real price and
   * real per-variant availability — or null, which is every reason there is
   * nothing to sell: commerce off, no preview cookie, or the Storefront API
   * unreachable (`getLiveProduct` in src/lib/commerce/index.ts folds all
   * three into this one answer). Null is what drives the pre-drop render
   * below, so a Shopify outage during the drop degrades to the page the
   * public saw the week before rather than to an error.
   *
   * A nullable product rather than the `commerceEnabled` boolean this used to
   * take: the price is the thing being gated, so the gate may as well *be*
   * the price's presence. There is no longer a way to render the buy band
   * without a number that came from Shopify.
   */
  live: Product | null
}

const { locale, live } = Astro.props
const d = t(locale)
const product = featuredProduct(locale)
const editorial = editorialFor(product.id, locale)

const site = Astro.site?.origin ?? 'https://nuageathletics.com'
const productUrl = new URL(Astro.url.pathname, site).href

/**
 * The fit a no-JS `?fit=` link switched to (see the <noscript> pair below),
 * validated against the real id list rather than trusted outright. Read here
 * rather than threaded through from index.astro/en/index.astro: this
 * component already owns `DEFAULT_FIT` and is the one place both callers'
 * `initialFit` prop comes from.
 */
const requestedFit = Astro.url.searchParams.get('fit')
const initialFit: FitId = (FIT_IDS as readonly string[]).includes(requestedFit ?? '')
  ? (requestedFit as FitId)
  : DEFAULT_FIT

/**
 * The failure half of a no-JS /api/cart submit, folded into the query
 * string by its 303 redirect (`ce=<code>`) — read back here and passed into
 * ProductStage as `initialErrorCode` so the server render and the first
 * client render agree, same pattern as SignupForm.tsx's own
 * `initialErrorCode`.
 */
const errorCode = Astro.url.searchParams.get('ce') ?? undefined

/**
 * The success half. `added=1` still means "nothing to report" and renders
 * the ordinary idle band, exactly as a fresh visit does — but it now also
 * carries `/api/cart`'s notice codes, which do have something to report:
 * Shopify had fewer than were asked for and clamped the line. A no-JS
 * submit lands back here and this is its only chance to be told, so unlike
 * the bare flag this one is read back into the band.
 */
const noticeCode = Astro.url.searchParams.get('added') ?? undefined

/**
 * No price is rendered while commerce is off, and structured data follows
 * the same rule: Product markup with an `Offer` is a claim that the thing is
 * for sale at a stated price, and until Shopify answers there is no price to
 * make that claim with. An `Offer` with `availability` but no `price` used to
 * be emitted here for the pre-drop case — that's an invalid Offer per
 * schema.org/Google's Merchant listing rules (price or priceSpecification.price
 * is required whenever `offers` is present), which is exactly the "critical"
 * Search Console error this replaced. So: no live price, no Product markup at
 * all. Same principle as ProductView taking a nullable `Product` instead of a
 * `commerceEnabled` boolean (see the Props doc above) — there is no code path
 * that emits an Offer without a Shopify price behind it either.
 */
const jsonLd = live
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      '@id': `${productUrl}#product`,
      url: productUrl,
      name: product.name,
      description: product.description,
      image: product.images.map((src) => new URL(src, Astro.site).href),
      /**
       * A reference, not a copy — but with `@type` repeated inline. This used
       * to be a bare `{'@id': organizationId(site)}`: a reference to the
       * Organization node Seo.astro emits in its own <script> tag, so a
       * consumer that resolves @id across a page's JSON-LD sees one company.
       * Google's Merchant listing validator apparently doesn't do that
       * resolution — it flagged this as "Invalid object type for field
       * 'brand'" even though the reference is valid schema.org. Repeating
       * `@type` here costs nothing (it's still the same node once @id is
       * resolved) and satisfies a parser that only looks at this object.
       */
      brand: { '@type': 'Organization', '@id': organizationId(site) },
      material: editorial.specs[0]?.value,
      /**
       * schema.org's countryOfOrigin means country of manufacture, same as a
       * garment tag — it is not the brand's home country or where it was
       * designed. This garment is made in China; catalogue.ts's spec list says
       * so too, split from the separate "Conception"/"Design" row for Quebec so
       * neither fact is stated in a way that could be misread as the other. A
       * shopping engine or answer engine reading `countryOfOrigin: 'Canada'`
       * here — which an earlier version of this field said — would be reading a
       * false Made-in-Canada claim, not a stylistic choice.
       */
      countryOfOrigin: { '@type': 'Country', name: 'China' },
      inLanguage: HTML_LANG[locale],
      offers: {
        '@type': 'Offer',
        priceCurrency: live.price.currency,
        price: (live.price.amount / 100).toFixed(2),
        // Real availability, not a constant: a drop that has sold through
        // every size shouldn't keep telling shopping engines it's in stock.
        availability: live.variants.some((v) => v.inStock)
          ? 'https://schema.org/InStock'
          : 'https://schema.org/SoldOut',
        /**
         * shippingDetails and hasMerchantReturnPolicy are Search Console's
         * remaining non-critical asks here. Deliberately not added: the only
         * shipping/return terms this site states anywhere are the draft CPA
         * disclosure (informations-precontractuelles.astro /
         * pre-contract-information.astro), which is marked "Draft, pending
         * legal review. May not reflect the final text." and doesn't even
         * commit to a return policy. Structured data is a claim a shopping
         * engine will show verbatim; publishing invented numbers (a return
         * window, a free-shipping threshold) to silence a non-critical
         * warning would be the same mistake 5.5 in CLAUDE.md guards against
         * for price, just aimed at a different field. Add these once real,
         * legally-reviewed terms exist to source them from.
         */
      },
    }
  : null
---

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

{/*
  A single centred column at every breakpoint — no sticky right-hand buy
  panel any more. The old two-column grid put the carousel and the buy
  panel in separate flows that could drift out of sync (a tall spec list
  pushing the panel below the fold on a short viewport, say); this design
  has exactly one flow, and the fixed-height band inside ProductStage is
  what keeps *that* from reflowing as its own state changes.
*/}
<article class="mx-auto max-w-[34rem] py-8 lg:py-12">
  {
    !live ? (
      /*
        The garment's design isn't final, so no photography reaches this
        branch at all — not the carousel, not the <noscript> gallery. What's
        here instead is the announcement itself, promoted to display scale
        and centred over the sky (Sky.astro renders full-bleed behind this
        whole page): the one thing this site can honestly show before the
        design is settled is that a drop is coming.

        This used to reserve the exact height the fit picker and buy band
        occupy in the commerce branch below, so switching founder preview on
        wouldn't move a shared photograph by a pixel. There is no longer a
        shared photograph to pin — the carousel now lives entirely inside the
        `live` branch — so that reservation is gone with it. The screenful
        centring stays: the page should still read as a considered whole, not
        a top-aligned scrap, whether or not there's a product underneath.
      */
      <div class="flex min-h-[calc(100dvh-var(--header-h)-4rem)] flex-col items-center justify-center text-center lg:min-h-[calc(100dvh-var(--header-h)-6rem)]">
        {/*
          Three lines, one h1, one voice: what's dropping, what the brand
          is, when. `d.tagline` sits between the two drop-announcement
          strings rather than above them in its own paragraph — the earlier
          version, with tagline muted and set apart — because all three are
          the same kind of statement (short, flat, declarative) and reading
          them as three facts in one notice beat reading them as a caption
          plus a separate announcement.

          Not a separate brand-name heading above it either: the header's
          own logo link already carries `aria-label={d.brand}` (Base.astro),
          so an h1 repeating "Nuage Athletics" here would be the same fact
          said twice on every render, not a heading for this page's own
          content. `tagline` is reused rather than rewritten for the same
          reason it was pulled in at all — it already exists for
          `<title>`/og:title (Seo.astro) and needs no new translation.
          Monospace, uppercase and tracked out for all three lines — this is
          a notice, not prose, and it should read as one at a glance.

          `tagline`'s own full stop is stripped here, not from the string
          itself: `<title>`/og:title (Seo.astro) and the meta description
          (`${d.tagline} ${d.dropLine}`, index.astro) both need it as a
          complete sentence, but neither sibling line in this h1 carries
          terminal punctuation, and reading three lines as one notice means
          matching that, not making tagline the odd one out.
        */}
        <h1 class="font-mono text-xs uppercase leading-loose tracking-label">
          {d.dropAnnounceFirst}
          <br />
          {d.tagline.replace(/\.$/, '')}
          <br />
          {d.dropAnnounceAvailability}
        </h1>
      </div>
    ) : (
      <>
        {/*
          Description, fit/size pickers and the spec table are all product
          *detail* — reachable only once there is something to buy, exactly
          as before this redesign. A non-null `live` already carries the
          founder-preview exception (src/lib/commerce/index.ts), so a
          founder previewing the buy flow sees all of it exactly as it will
          ship — the real Shopify price included, which is why
          `price`/`variants`/`specs` are only ever computed and passed down
          inside this branch.
          See the props-serialization note in ProductStage.tsx: those values
          become part of the island's server-rendered `astro-island` props
          attribute, so keeping them out of the `!live` branch
          entirely (not just out of what renders) is what non-negotiable 5.5
          actually requires.
        */}
        {/*
          Reserves a full screen regardless of how tall the carousel's own
          frame ends up (ProductCarousel.tsx caps it short of this once the
          photo hits its width) — the CPA disclosure right after this block
          must never peek into view unscrolled, and a min-height is what
          guarantees that independent of the frame's actual size, rather
          than relying on the frame happening to fill the space.
          Not a bare `min-h-dvh`: the sticky header sits above this article,
          not inside it, and the article's own `py-8 lg:py-12` sits outside
          this box, so the reservation is the screen minus both. Getting the
          padding wrong doesn't show up while the content is top-aligned —
          the box just runs past the fold and nobody notices — but it lands
          the moment the content is centred inside it, as lopsided air:
          everything shifts down by half the overhang.

          `justify-center` is what puts whatever's left over *around* the
          photo rather than all of it under the band: the reference sets the
          product with air above and below it, not pinned to the top of the
          screen with the slack pooled at the bottom. It can't strand
          anything off-screen the way centred flex content usually can —
          min-height is a floor, not a cap, so on a window too short for the
          content the box simply grows past it, there is no free space to
          distribute, and this lays out exactly as it would without the
          class.
        */}
        <div class="flex min-h-[calc(100dvh-var(--header-h)-4rem)] flex-col justify-center lg:min-h-[calc(100dvh-var(--header-h)-6rem)]">
          <ProductStage
            client:load
            {locale}
            d={d}
            productId={product.id}
            productName={product.name}
            fits={editorial.fits}
            {initialFit}
            fitOptions={editorial.fits.map((f) => ({ id: f.id, label: f.label }))}
            variants={live.variants}
            price={formatPrice(live.price, locale)}
            precontractHref={route('precontract', locale)}
            redirectTo={Astro.url.pathname + Astro.url.search}
            initialErrorCode={errorCode}
            initialNoticeCode={noticeCode}
          />
          {/* Images are content, not chrome — the carousel needs JS to page
              through them, but every photo still has to reach a no-JS
              visitor. The description/spec list needs no <noscript> twin any
              more: ProductDetails.astro below is server-rendered plain HTML
              for everyone, not a JS-only panel. */}
          <noscript>
            <div class="mt-3 grid grid-cols-2 gap-3">
              {editorial.fits.flatMap((fit) =>
                fit.gallery.map((image) => (
                  <img
                    src={image.src}
                    width={image.width}
                    height={image.height}
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                    class="w-full object-contain"
                  />
                ))
              )}
            </div>
            {/*
              ProductStage's fit tabs are one RadioGroup — real controls, but
              hydration is what wires them to which fit's sizes the form
              offers. Without JS the form only ever submits the fit it was
              rendered with (`initialFit`), so a no-JS visitor otherwise has
              no way to buy the other fit at all. This is that way: a plain
              link back to the same page with `?fit=` set, which
              ProductView.astro reads server-side above. Only the fit not
              already showing — switching to the one already selected would
              be a link to do nothing.
            */}
            <p class="mt-3 text-center font-mono text-[11px] uppercase tracking-label">
              {editorial.fits
                .filter((f) => f.id !== initialFit)
                .map((f) => (
                  <a href={`?fit=${f.id}`} class="underline-sweep hover:text-accent-ink">
                    {fmt(d.productViewFit, { fit: f.label })}
                  </a>
                ))}
            </p>
          </noscript>
        </div>

        <ProductDetails {locale} {d} description={product.description} specs={editorial.specs} />
      </>
    )
  }
</article>
