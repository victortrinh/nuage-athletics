---
// PROTOTYPE — throwaway, issue #121. Never ships: Base.astro mounts this only
// under import.meta.env.DEV.
//
// Question: what should a glowing glyph field with click ripples (Claude
// desktop's "Landing Texture") look like in Nuage's cloud branding?
// Three variants on the real home page, switchable via `?glyph=A|B|C`
// (or ← / → keys, or the bar at the bottom). `?glyph=` absent = the real sky.
//
//   A  Bruine   — closest to the original: dense weather-glyph grid, drifting
//                 wind highlights, click ripples, calm zone around the h1.
//   B  Averse   — rain: drops fall down columns, clicks land as puddle rings.
//   C  Nuage    — the cloud deck itself drawn in ASCII (density → glyph ramp),
//                 ripples as pressure waves through it. Replaces the sky.
---

<div id="glyph-proto" class="fixed inset-0 -z-10 pointer-events-none" aria-hidden="true" hidden>
  <canvas class="absolute inset-0 h-full w-full"></canvas>
</div>
<div
  id="glyph-proto-bar"
  class="fixed bottom-20 left-1/2 z-[60] flex -translate-x-1/2 items-center gap-3 bg-ink px-3 py-2 font-mono text-xs text-paper shadow-lg"
>
  <button type="button" data-dir="-1" class="px-2">←</button>
  <span data-label class="min-w-48 text-center">…</span>
  <button type="button" data-dir="1" class="px-2">→</button>
</div>

<script>
  type Key = 'sky' | 'A' | 'B' | 'C'
  const KEYS: Key[] = ['sky', 'A', 'B', 'C']
  const NAMES: Record<Key, string> = {
    sky: 'Sky (current site)',
    A: 'A · Bruine (wind field)',
    B: 'B · Averse (rain)',
    C: 'C · Nuage (ASCII cloud deck)',
  }

  // Brand tokens, global.css
  const INK = [10, 10, 10]
  const MUTE = [99, 105, 110]
  const ACCENT = [79, 124, 255]
  const ACCENT_INK = [58, 95, 217]

  const params = new URLSearchParams(location.search)
  const raw = params.get('glyph')?.toUpperCase()
  const key: Key = raw === 'A' || raw === 'B' || raw === 'C' ? raw : 'sky'

  // ---- switcher -----------------------------------------------------------
  const bar = document.getElementById('glyph-proto-bar')!
  bar.querySelector('[data-label]')!.textContent = NAMES[key]
  function go(dir: number) {
    const next = KEYS[(KEYS.indexOf(key) + dir + KEYS.length) % KEYS.length]
    const u = new URL(location.href)
    if (next === 'sky') u.searchParams.delete('glyph')
    else u.searchParams.set('glyph', next)
    location.replace(u)
  }
  bar.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
    b.addEventListener('click', () => go(Number(b.dataset.dir)))
  )
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement
    if (t.closest('input, textarea, [contenteditable]')) return
    if (e.key === 'ArrowLeft') go(-1)
    if (e.key === 'ArrowRight') go(1)
  })

  if (key !== 'sky') run(key)

  function run(variant: 'A' | 'B' | 'C') {
    // Hide the real sky (both canvas and fallback) for the comparison.
    const sky = document.querySelector<HTMLElement>('.sky-canvas')?.parentElement
    if (sky) sky.style.visibility = 'hidden'
    const host = document.getElementById('glyph-proto')!
    host.hidden = false
    const canvas = host.querySelector('canvas')!
    const ctx = canvas.getContext('2d')!
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

    const CELL = variant === 'C' ? 12 : 16
    const LEVELS = 12
    const GLYPHS: Record<typeof variant, string> = {
      // weather-ish marks: drizzle, droplets, degrees, gusts
      A: '·˙.,\'°∘:~≈+*',
      // rain: streaks and splash
      B: '·.\'|¦,:;○◦∘',
      // density ramp, light → heavy cloud
      C: ' ·.:-~=≈+*#',
    }
    const glyphs = GLYPHS[variant]

    let dpr = 1, W = 0, H = 0, cols = 0, rows = 0
    let atlas: HTMLCanvasElement

    // Pre-render every glyph at every intensity, glow baked in, so a frame is
    // only drawImage calls.
    function buildAtlas() {
      const s = CELL * dpr
      atlas = document.createElement('canvas')
      atlas.width = s * glyphs.length
      atlas.height = s * LEVELS
      const a = atlas.getContext('2d')!
      a.textAlign = 'center'
      a.textBaseline = 'middle'
      a.font = `${Math.round(s * 0.72)}px ui-monospace, SFMono-Regular, Menlo, monospace`
      for (let l = 0; l < LEVELS; l++) {
        const k = l / (LEVELS - 1)
        // rest = faint mute grey; crest = accent with a glow
        const c = k < 0.5 ? mix(MUTE, ACCENT_INK, k * 2) : mix(ACCENT_INK, ACCENT, (k - 0.5) * 2)
        const alpha = 0.10 + 0.9 * Math.pow(k, 1.3)
        for (let g = 0; g < glyphs.length; g++) {
          const x = g * s + s / 2, y = l * s + s / 2
          a.shadowColor = `rgba(${ACCENT.join(',')},${0.9 * k})`
          a.shadowBlur = k > 0.35 ? s * 0.6 * k : 0
          a.fillStyle = `rgba(${c.join(',')},${alpha})`
          a.fillText(glyphs[g], x, y)
          if (k > 0.75) a.fillText(glyphs[g], x, y) // second pass = hotter core
        }
      }
    }
    function mix(a: number[], b: number[], t: number) {
      return a.map((v, i) => Math.round(v + (b[i] - v) * t))
    }

    let calm = { x: 0, y: 0, w: 0, h: 0 }
    function resize() {
      dpr = Math.min(devicePixelRatio || 1, 2)
      W = innerWidth; H = innerHeight
      canvas.width = W * dpr; canvas.height = H * dpr
      cols = Math.ceil(W / CELL) + 1; rows = Math.ceil(H / CELL) + 1
      buildAtlas()
      seed = new Float32Array(cols * rows).map(() => Math.random())
      drops = Array.from({ length: cols }, () => newDrop(true))
      const h1 = document.querySelector('main h1, #content h1')
      if (h1) {
        const r = h1.getBoundingClientRect()
        calm = { x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width / 2 + 48, h: r.height / 2 + 40 }
      }
    }
    let seed = new Float32Array(0)

    // ---- noise (value noise, 2 octaves is plenty for a prototype) ---------
    const P = new Uint8Array(512).map((_, i) => i & 255)
    for (let i = 255; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [P[i], P[j]] = [P[j], P[i]] }
    for (let i = 0; i < 256; i++) P[i + 256] = P[i]
    const h2 = (x: number, y: number) => P[(P[x & 255] + y) & 511] / 255
    function vnoise(x: number, y: number) {
      const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi
      const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf)
      const a = h2(xi, yi), b = h2(xi + 1, yi), c = h2(xi, yi + 1), d = h2(xi + 1, yi + 1)
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v
    }
    const fbm = (x: number, y: number) => 0.6 * vnoise(x, y) + 0.3 * vnoise(x * 2.1, y * 2.1) + 0.1 * vnoise(x * 4.3, y * 4.3)

    // ---- ripples ----------------------------------------------------------
    type Ripple = { x: number; y: number; t0: number; amp: number }
    const ripples: Ripple[] = []
    const SPEED = variant === 'B' ? 220 : 320 // px/s
    const LIFE = 2.6 // s
    const WIDTH = variant === 'C' ? 46 : 34 // px, ring thickness
    let pointer = { x: -9999, y: -9999 }
    addEventListener('pointerdown', (e) => {
      ripples.push({ x: e.clientX, y: e.clientY, t0: performance.now() / 1000, amp: 1 })
    })
    addEventListener('pointermove', (e) => { pointer = { x: e.clientX, y: e.clientY } })
    let nextIdle = 1.5
    function ripplesAt(x: number, y: number, t: number) {
      let s = 0
      for (const r of ripples) {
        const age = t - r.t0
        const d = Math.hypot(x - r.x, y - r.y)
        const front = age * SPEED
        const k = (d - front) / WIDTH
        // leading crest plus a weaker trailing one, like water
        const ring = Math.exp(-k * k) + 0.35 * Math.exp(-((k + 2.2) ** 2))
        s += r.amp * ring * Math.pow(1 - age / LIFE, 1.6) * (1 / (1 + d / 900))
      }
      return s
    }

    // ---- rain (B) ----------------------------------------------------------
    type Drop = { y: number; v: number; len: number; land: number }
    let drops: Drop[] = []
    function newDrop(initial = false): Drop {
      return {
        y: initial ? Math.random() * -rows * 1.5 : -Math.random() * rows * 0.8,
        v: 14 + Math.random() * 22, // cells/s
        len: 3 + Math.random() * 6,
        land: rows * (0.35 + Math.random() * 0.7),
      }
    }

    function calmAt(x: number, y: number) {
      if (!calm.w) return 1
      const dx = (x - calm.x) / calm.w, dy = (y - calm.y) / calm.h
      const d = Math.sqrt(dx * dx + dy * dy)
      return Math.min(1, Math.max(0.08, (d - 0.7) / 0.9))
    }

    let last = performance.now() / 1000
    function frame() {
      const t = performance.now() / 1000
      const dt = Math.min(0.05, t - last); last = t
      while (ripples.length && t - ripples[0].t0 > LIFE) ripples.shift()
      if (!reduce && t > nextIdle) {
        // idle ripples so the field is alive without a pointer
        ripples.push({ x: Math.random() * W, y: Math.random() * H, t0: t, amp: 0.55 })
        nextIdle = t + 2.5 + Math.random() * 3
      }
      if (variant === 'B') {
        for (const d of drops) {
          d.y += d.v * dt
          if (d.y > d.land) {
            if (Math.random() < 0.08)
              ripples.push({ x: (drops.indexOf(d) + 0.5) * CELL, y: d.land * CELL, t0: t, amp: 0.35 })
            Object.assign(d, newDrop())
          }
        }
      }

      ctx.setTransform(1, 0, 0, 1, 0, 0)
      ctx.globalCompositeOperation = 'source-over'
      ctx.fillStyle = '#fafafa'
      ctx.fillRect(0, 0, canvas.width, canvas.height)
      const s = CELL * dpr
      const tw = reduce ? 0 : t
      for (let j = 0; j < rows; j++) {
        for (let i = 0; i < cols; i++) {
          const x = i * CELL + CELL / 2, y = j * CELL + CELL / 2
          const sd = seed[j * cols + i]
          let level = 0, g = 0
          const rip = ripplesAt(x, y, t)
          const hover = Math.exp(-(((x - pointer.x) ** 2 + (y - pointer.y) ** 2) / (2 * 70 * 70)))
          const quiet = calmAt(x, y)

          if (variant === 'A') {
            // wind: low-frequency field drifting diagonally
            const wind = fbm(x / 260 - tw * 0.09, y / 260 - tw * 0.035)
            const gust = Math.max(0, wind - 0.52) * 3.2
            const k = (0.04 + gust * 0.55 + rip * 0.9 + hover * 0.35) * quiet
            level = k
            // denser glyph where energy is higher, per-cell jitter keeps it a field
            g = Math.min(glyphs.length - 1, Math.floor(sd * 4 + k * (glyphs.length - 3)))
          } else if (variant === 'B') {
            const d = drops[i]
            const behind = d.y - j
            let streak = 0
            if (behind >= 0 && behind < d.len && j < d.land) streak = 1 - behind / d.len
            const k = (0.03 + streak * 0.55 + rip * 1.0 + hover * 0.3) * quiet
            level = k
            if (rip > 0.25) g = 8 + Math.min(2, Math.floor(rip * 3)) // ring glyphs ○◦∘
            else if (streak > 0) g = behind < 1 ? 2 : streak > 0.5 ? 3 : 4
            else g = sd < 0.75 ? 0 : 1
          } else {
            // cloud deck: density from drifting fbm, ripple pushes density up
            const dens = fbm(x / 340 - tw * 0.03, y / 210 + tw * 0.008)
            const cloud = Math.max(0, Math.min(1, (dens - 0.38) * 2.4 + rip * 0.5 + hover * 0.15))
            g = Math.min(glyphs.length - 1, Math.floor(cloud * (glyphs.length - 0.01)))
            level = (0.12 + cloud * 0.25 + rip * 0.85) * quiet
            if (g === 0) continue
          }
          if (level < 0.02 && variant !== 'C') { if (sd > 0.5) continue; level = 0.02 }
          const l = Math.min(LEVELS - 1, Math.round(level * (LEVELS - 1)))
          ctx.drawImage(atlas, g * s, l * s, s, s, i * s, j * s, s, s)
        }
      }
      if (!reduce) requestAnimationFrame(frame)
    }
    resize()
    addEventListener('resize', resize)
    requestAnimationFrame(frame)
    if (reduce) addEventListener('pointerdown', () => requestAnimationFrame(frame))
  }
</script>
