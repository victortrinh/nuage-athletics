---
import type { GallerySlot } from '../lib/catalogue'

/**
 * The product gallery: one DOM list that reads as a horizontal snap strip on a
 * phone and a stacked column beside the sticky detail panel on a desktop.
 *
 * No JavaScript. Scroll snapping and sticky positioning are both CSS, and an
 * island here would buy nothing but hydration cost — the repo's default is
 * zero JS unless interaction genuinely demands it.
 *
 * There are no photographs yet. A slot with no `src` renders as a ruled
 * placeholder at its final aspect ratio, so the layout being reviewed now is
 * the layout that ships; only the pixels are outstanding.
 */
interface Props {
  slots: GallerySlot[]
  label: string
}

const { slots, label } = Astro.props
---

<ul
  aria-label={label}
  class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 lg:flex-col lg:gap-3 lg:overflow-visible lg:pb-0 lg:[scroll-snap-type:none]"
>
  {
    slots.map((slot, i) => (
      <li class="w-[84%] shrink-0 snap-start sm:w-[58%] lg:w-full lg:shrink">
        {slot.src ? (
          <img
            src={slot.src}
            alt={slot.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="w-full object-cover"
            style={`aspect-ratio: ${slot.ratio}`}
          />
        ) : (
          <div
            class="relative w-full border border-line bg-[linear-gradient(135deg,#f2f2f2_0%,#e9e9e9_100%)]"
            style={`aspect-ratio: ${slot.ratio}`}
            role="img"
            aria-label={slot.alt}
          >
            <span class="absolute bottom-3 left-3 text-[10px] uppercase tracking-label text-mute">
              {String(i + 1).padStart(2, '0')} / {String(slots.length).padStart(2, '0')}
            </span>
          </div>
        )}
      </li>
    ))
  }
</ul>
