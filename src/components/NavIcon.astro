---
/**
 * The nav drawer's trigger and close icons. `bars` is the same three
 * unequal-length rounded strokes the sky toggle's wind lines use
 * (Base.astro), read as cloud strata rather than a generic hamburger, drawn
 * in that icon's wide 26x16 viewBox. `close` gets its own square 16x16
 * viewBox and a square h-4 w-4 box instead of reusing the wide one — an X
 * drawn inside a non-square box comes out visibly stretched into a
 * rectangle, which the wide viewBox never has to answer for since its own
 * strokes are horizontal lines with no diagonal to distort.
 *
 * Plain .astro, not a React island: static markup with a CSS-only hover
 * animation, so it ships no JS at all, same as everything else on the site
 * apart from the drawer's own open/close script.
 *
 * `bars` drifts each stroke a different distance on hover, staggered, so
 * the set reads as wind rather than a rigid block. `close` is a static X —
 * there is no morph animation from one to the other: the close button sits
 * at the trigger's own position once the panel is open, and that position
 * continuity is what reads as the transformation, the same way
 * GateScreen's disclosure doesn't animate its own marker.
 */
interface Props {
  variant: 'bars' | 'close'
}

const { variant } = Astro.props
---

{
  variant === 'bars' ? (
    <svg
      class="h-4 w-6 overflow-visible"
      viewBox="0 0 26 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line
        x1="3"
        y1="4"
        x2="23"
        y2="4"
        class="motion-safe:transition-[translate] motion-safe:duration-300 motion-safe:ease-out motion-safe:group-hover:translate-x-[2px]"
      />
      <line
        x1="3"
        y1="8"
        x2="17"
        y2="8"
        class="motion-safe:transition-[translate] motion-safe:duration-300 motion-safe:delay-75 motion-safe:ease-out motion-safe:group-hover:translate-x-[3px]"
      />
      <line
        x1="3"
        y1="12"
        x2="20"
        y2="12"
        class="motion-safe:transition-[translate] motion-safe:duration-300 motion-safe:delay-150 motion-safe:ease-out motion-safe:group-hover:translate-x-[1px]"
      />
    </svg>
  ) : (
    <svg
      class="h-4 w-4 overflow-visible"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="3" y1="3" x2="13" y2="13" />
      <line x1="13" y1="3" x2="3" y2="13" />
    </svg>
  )
}
